{
  "$comment": "WHAT IS PROJECTED WHERE. Each entry is one projection the engine writes, and adding one is an entry here. Why is [[one-source-projected-everywhere]].",
  "projections": [
    {
      "name": "copilot instructions",
      "target": ".github/copilot-instructions.md",
      "wrap": "markdown",
      "section": "Actionables",
      "sources_from": "doc/guidance"
    },
    {
      "name": "claude output style",
      "target": ".claude/output-styles/quackitect.md",
      "wrap": "frontmatter",
      "frontmatter": {
        "name": "quackitect"
      },
      "section": "Actionables",
      "sources_from": "doc/guidance",
      "preamble": "util/cage/first-turn.md"
    },
    {
      "name": "claude cage",
      "target": ".claude/settings.json",
      "sources": [
        "util/cage/claude-settings.json"
      ],
      "wrap": "none"
    },
    {
      "name": "claude door",
      "target": ".claude/settings.local.json",
      "sources": [
        "util/cage/claude-settings-local.json"
      ],
      "wrap": "none",
      "local": true
    },
    {
      "name": "copilot cage",
      "target": ".copilot/mcp-config.json",
      "sources": [
        "util/cage/copilot-mcp.json"
      ],
      "wrap": "none"
    },
    {
      "name": "claude tool lane",
      "target": ".mcp.json",
      "sources": [
        "util/cage/mcp.json"
      ],
      "wrap": "none"
    },
    {
      "name": "the wake",
      "target": ".claude/hooks/session-start.sh",
      "sources": [
        "util/cage/session-start.sh"
      ],
      "wrap": "none"
    }
  ]
}
