{
  "name": "quackitect",
  "displayName": "quackitect",
  "description": "quackitect, drawn as a sidebar. One declaration says what every value is and where it draws.",
  "version": "0.1.0",
  "private": true,
  "publisher": "quackitect",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "activationEvents": [
    "workspaceContains:spec/config/level0.schema.json"
  ],
  "scripts": {
    "package": "npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "contributes": {
    "commands": [
      {
        "command": "quackitect.ticket",
        "title": "quackitect: a ticket button"
      },
      {
        "command": "quackitect.route.flip",
        "title": "quackitect: flip the drawing and the YAML"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quackitect.ticket",
          "when": "false"
        },
        {
          "command": "quackitect.route.flip",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quackitect",
          "title": "quackitect",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "quackitect": [
        {
          "type": "webview",
          "id": "quackitect.sidebar",
          "name": "quackitect",
          "when": "quackitect.here"
        }
      ]
    }
  },
  "enabledApiProposals": [
    "editorInsets"
  ]
}
