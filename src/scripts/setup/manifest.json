{
  "product": {
    "id": "quackitect",
    "name": "quackitect",
    "version": "0.1.0"
  },
  "profiles": {
    "desktop": [
      "git",
      "go",
      "xz",
      "zig",
      "node",
      "ripgrep",
      "vscode"
    ],
    "headless": [
      "git",
      "go",
      "xz",
      "zig",
      "node",
      "ripgrep"
    ]
  },
  "tools": {
    "xz": {
      "probe": "xz",
      "apt": "xz-utils",
      "only": "linux",
      "why": "the zig archive for Linux is tar.xz, and tar needs xz to open it"
    },
    "git": {
      "probe": "git",
      "winget": "Git.Git",
      "apt": "git",
      "why": "the archive is version history"
    },
    "go": {
      "probe": "go",
      "winget": "GoLang.Go",
      "apt": "golang-go",
      "why": "the engine and the log window are written in it"
    },
    "node": {
      "probe": "node",
      "winget": "OpenJS.NodeJS.LTS",
      "apt": "nodejs",
      "why": "the editor extension is built with it"
    },
    "ripgrep": {
      "probe": "rg",
      "winget": "BurntSushi.ripgrep.MSVC",
      "apt": "ripgrep",
      "why": "search"
    },
    "vscode": {
      "probe": "code",
      "winget": "Microsoft.VisualStudioCode",
      "apt": "",
      "why": "the intended user interface"
    },
    "zig": {
      "why": "the engine's SQLite is C, and cgo needs a C compiler",
      "archive": {
        "version": "0.16.0",
        "platforms": {
          "windows/amd64": {
            "url": "https://ziglang.org/download/0.16.0/zig-x86_64-windows-0.16.0.zip",
            "sha256": "68659eb5f1e4eb1437a722f1dd889c5a322c9954607f5edcf337bc3684a75a7e",
            "size": 97217739
          },
          "linux/amd64": {
            "url": "https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz",
            "sha256": "70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00",
            "size": 55478392
          }
        }
      }
    }
  },
  "cc": "zig",
  "builds": [
    {
      "name": "se",
      "source": "src/engine",
      "why": "the engine"
    },
    {
      "name": "logview",
      "source": "src/viewer",
      "why": "the log window"
    },
    {
      "name": "se-mcp",
      "source": "src/mcp",
      "why": "the tool lane between an agent and the engine"
    }
  ]
}
