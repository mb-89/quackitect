{
  "version": 1,
  "$owner": "quackitect-level0",
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": ".se/.runtime/bin/se-index verb src/scripts hook SessionStart",
        "timeout": 60,
        "timeoutSec": 60
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": ".se/.runtime/bin/se-index verb src/scripts hook PreToolUse",
        "timeout": 60,
        "timeoutSec": 60
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": ".se/.runtime/bin/se-index verb src/scripts hook PostToolUse",
        "timeout": 60,
        "timeoutSec": 60
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": ".se/.runtime/bin/se-index verb src/scripts hook Stop",
        "timeout": 60,
        "timeoutSec": 60
      }
    ]
  }
}
