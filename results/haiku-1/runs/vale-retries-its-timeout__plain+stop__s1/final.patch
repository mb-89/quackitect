+// A Vale that answers E201 on one run and rows on the next, the way a load trips its cap once. [[spec/tickets/vale-retries-its-timeout]]
+func TestAValeCapRetriesThenDrawsRows(t *testing.T) {
+	fake := &fakeTools{says: map[string]string{"vale": valeSays("/tree/spec/b.md", "VoiceVale.Sentence", "Some")}}
+	capped := true
+	run := fake.run
+	tools := func(dir, input, name string, argv ...string) (string, error) {
+		if name == "vale" && capped {
+			capped = false
+			fake.mu.Lock()
+			fake.calls = append(fake.calls, name+" "+strings.Join(argv, " "))
+			fake.mu.Unlock()
+			return "", errors.New("exit status 1: E201 the rule breaks under load")
+		}
+		return run(dir, input, name, argv...)
+	}
+	store, as := catalogOf(t)
+	server := New(Outside{
+		Root: "/tree", Store: store, As: as, Bound: func(local string) string { return local },
+		Sweep: func() any { return []Finding{} },
+		Tools: &Tools{Root: "/tree", Vale: "vale", Biome: "biome", Config: ".vale.ini", Run: tools, Check: fakeCheck},
+		Files: func() map[string]string { return map[string]string{"spec/b.md": "# B\n\nSome text\n"} },
+	})
+	var (
+		mu     sync.Mutex
+		pushed [][]byte
+	)
+	server.Pushes(func(bodies ...[]byte) {
+		mu.Lock()
+		defer mu.Unlock()
+		pushed = append(pushed, bodies...)
+	})
+	if drawn := drawnOn(server.SweepTools(), "file:///tree/spec/b.md"); !holds(drawn, "vale", "Sentence") {
+		t.Fatalf("the closed file draws %+v after one E201, and wants its Vale row on the second run", drawn)
+	}
+	if n := valeRuns(fake.calls); n != 2 {
+		t.Fatalf("vale ran %d times, and wants 2: one capped run, then the run with rows: %q", n, fake.calls)
+	}
+}
+
+func TestAValeCapStopsAfterValeTries(t *testing.T) {
+	fake := &fakeTools{fails: map[string]error{"vale": errors.New("exit status 1: E201 the rule breaks under load")}}
+	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n"}, fake)
+	if drawn := drawnOn(server.SweepTools(), "file:///tree/.vale.ini"); !holds(drawn, "vale", "ValeRuns") {
+		t.Fatalf("the config draws %+v, and wants ValeRuns after the cap holds", drawn)
+	}
+	if n := valeRuns(fake.calls); n != valeTries {
+		t.Fatalf("vale ran %d times, and wants valeTries (%d): %q", n, valeTries, fake.calls)
+	}
+}
+
+// The runs of Vale among the calls a fake took, which a sweep also beside Biome. [[spec/tickets/vale-retries-its-timeout]]
+func valeRuns(calls []string) int {
+	n := 0
+	for _, call := range calls {
+		if strings.HasPrefix(call, "vale ") {
+			n++
+		}
+	}
+	return n
+}
