+// A fresh build that cannot swap in stops the verb loud: no plain rows, no ask for Go, and no stamp. Every name the old binary steps aside to is a folder, which a rename onto it refuses. [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiSwapFailureFailsLoud(t *testing.T) {
+	box := tuiBoxAt(t)
+	tuiWrites(t, box.root, map[string]string{
+		".se/.runtime/bin/logview":           "old binary",
+		".se/.log/session.jsonl":             tuiRowText,
+		".se/.runtime/bin/logview.old/held":  "held",
+		".se/.runtime/bin/logview.old1/held": "held",
+		".se/.runtime/bin/logview.old2/held": "held",
+		".se/.runtime/bin/logview.old3/held": "held",
+		".se/.runtime/bin/logview.old4/held": "held",
+		".se/.runtime/bin/logview.old5/held": "held",
+		".se/.runtime/bin/logview.old6/held": "held",
+		".se/.runtime/bin/logview.old7/held": "held",
+		".se/.runtime/bin/logview.old8/held": "held",
+	})
+	code, out, errs := box.runs()
+	if code != exitFailed || out != "" || errs == "" {
+		t.Fatalf("code %d, out %q, errs %q", code, out, errs)
+	}
+	if len(box.launched) != 0 || len(box.told) != 0 {
+		t.Errorf("launched %v, told %v", box.launched, box.told)
+	}
+	if _, err := os.Stat(box.root + "/.se/.runtime/bin/.logview-source"); err == nil {
+		t.Error("a failed swap stamps its source")
+	}
+}
