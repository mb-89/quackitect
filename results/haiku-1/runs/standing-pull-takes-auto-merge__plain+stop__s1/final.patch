+// A standing pull request already holding auto-merge is left untouched. [[spec/tickets/standing-pull-takes-auto-merge]]
+func TestDispatchLeavesAStandingPullRequestWithAutoMergeOnUntouched(t *testing.T) {
+	t.Parallel()
+	hub := newHub()
+	hub.pulls = append(hub.pulls, map[string]any{"number": 7, "node_id": "PR_7", "auto_merge": map[string]any{"merge_method": "merge"}, "head": map[string]any{"ref": "claude/dispatch-abc1234"}})
+	plan := dfPlan(nil, nil, nil, &writeRow{Branch: "claude/dispatch-abc1234", State: "standing"})
+	dfFired(hub, plan, nil)
+	for _, one := range hub.sent {
+		if one.URL == dfAPI+"/graphql" {
+			t.Fatal("the fire takes auto-merge on a standing pull request that holds it")
+		}
+	}
+	dpSame(t, plan.Fire.Pull.State, "standing")
+}
