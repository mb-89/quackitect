+// A fresh build that cannot swap in fails loud as an error, and names no reason beside it. [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiSwapFailureIsAnError(t *testing.T) {
+	box := tuiBoxAt(t)
+	files := map[string]string{".se/.runtime/bin/logview": "old binary"}
+	for _, name := range []string{"logview.old", "logview.old1", "logview.old2", "logview.old3", "logview.old4", "logview.old5", "logview.old6", "logview.old7", "logview.old8"} {
+		files[".se/.runtime/bin/"+name+"/held"] = "held"
+	}
+	tuiWrites(t, box.root, files)
+	exe, why, err := tuiViewerOf(box.doors())
+	if err == nil || exe != "" || why != "" {
+		t.Fatalf("exe %q, why %q, err %v", exe, why, err)
+	}
+}
