+// A verb run through quack's own road: the road and the words as argv, and under quiet a red verb's said reaches the error stream, so the why is not dropped. [[spec/tickets/the-verbs-need-no-wrapper]]
+func verbOver(run func(argv, env []string, quiet bool) (int, string, error), road, env []string, errs io.Writer) func(words []string, quiet bool) int {
+	return func(words []string, quiet bool) int {
+		argv := append(append([]string{}, road...), words...)
+		code, said, err := run(argv, env, quiet)
+		if err != nil {
+			fmt.Fprintln(errs, err)
+			return exitFailed
+		}
+		if quiet && code != 0 && strings.TrimSpace(said) != "" {
+			fmt.Fprintln(errs, strings.TrimRight(said, "\n"))
+		}
+		return code
+	}
+}
