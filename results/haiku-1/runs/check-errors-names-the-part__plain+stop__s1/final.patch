diff --git a/src/quack/verbover_test.go b/src/quack/verbover_test.go
new file mode 100644
index 0000000..64ff868
--- /dev/null
+++ b/src/quack/verbover_test.go
@@ -0,0 +1,83 @@
+// The verb road in Go: the road and the words as argv, and a quiet red verb's
+// why reaching the error stream.
+// [[spec/tickets/the-verbs-need-no-wrapper]]
+package main
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// [[spec/tickets/the-verbs-need-no-wrapper]]
+func TestVerbOver(t *testing.T) {
+	road := []string{"/bin/quack", "verb", "src/scripts"}
+	env := []string{"SE_LINT_FOUND=x"}
+
+	t.Run("the road and the words make the argv, with the env", func(t *testing.T) {
+		var gotArgv, gotEnv []string
+		run := func(argv, env []string, quiet bool) (int, string, error) {
+			gotArgv, gotEnv = argv, env
+			return 0, "", nil
+		}
+		verb := verbOver(run, road, env, &strings.Builder{})
+		if code := verb([]string{"lint", "src/quack"}, false); code != 0 {
+			t.Fatalf("a green verb answers %d", code)
+		}
+		if want := []string{"/bin/quack", "verb", "src/scripts", "lint", "src/quack"}; !reflect.DeepEqual(gotArgv, want) {
+			t.Fatalf("the argv reads %v, and want %v", gotArgv, want)
+		}
+		if !reflect.DeepEqual(gotEnv, env) {
+			t.Fatalf("the env reads %v, and want %v", gotEnv, env)
+		}
+	})
+	t.Run("the road is not changed by a run", func(t *testing.T) {
+		run := func(argv, env []string, quiet bool) (int, string, error) { return 0, "", nil }
+		verb := verbOver(run, road, env, &strings.Builder{})
+		verb([]string{"doors"}, false)
+		verb([]string{"project", "--check"}, false)
+		if want := []string{"/bin/quack", "verb", "src/scripts"}; !reflect.DeepEqual(road, want) {
+			t.Fatalf("the road reads %v, and want %v", road, want)
+		}
+	})
+	t.Run("under quiet a red verb's why reaches the error stream", func(t *testing.T) {
+		run := func(argv, env []string, quiet bool) (int, string, error) {
+			return 1, "src/quack/a.go:3: the lint refuses this\n", nil
+		}
+		var errs strings.Builder
+		verb := verbOver(run, road, env, &errs)
+		if code := verb([]string{"lint"}, true); code != 1 {
+			t.Fatalf("a red verb answers %d", code)
+		}
+		if got := errs.String(); got != "src/quack/a.go:3: the lint refuses this\n" {
+			t.Fatalf("the error stream reads %q", got)
+		}
+	})
+	t.Run("not under quiet, a red verb's said is not repeated on the error stream", func(t *testing.T) {
+		run := func(argv, env []string, quiet bool) (int, string, error) {
+			return 1, "already on the screen\n", nil
+		}
+		var errs strings.Builder
+		verb := verbOver(run, road, env, &errs)
+		if code := verb([]string{"lint"}, false); code != 1 {
+			t.Fatalf("a red verb answers %d", code)
+		}
+		if errs.Len() != 0 {
+			t.Fatalf("the error stream reads %q, and want nothing", errs.String())
+		}
+	})
+	t.Run("a verb that will not start says so, and answers failed", func(t *testing.T) {
+		run := func(argv, env []string, quiet bool) (int, string, error) {
+			return 0, "", errors.New("no such road")
+		}
+		var errs strings.Builder
+		verb := verbOver(run, road, env, &errs)
+		if code := verb([]string{"doors"}, false); code != exitFailed {
+			t.Fatalf("a verb that will not start answers %d", code)
+		}
+		if !strings.Contains(errs.String(), "no such road") {
+			t.Fatalf("the error stream reads %q", errs.String())
+		}
+	})
+}
