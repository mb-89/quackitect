+
+// The desk's refusal prints the node's remedy once, on the work-branch pull and the named pull on trunk alike. [[spec/tickets/the-twins-leave-whole]]
+func TestDeskPullPrintsTheRemedyOnce(t *testing.T) {
+	t.Parallel()
+	remedy := "Run git switch main, and take a finished cloud branch in with ./RUNME.sh branch merge <name>."
+	cases := []struct {
+		name   string
+		branch string
+		argv   []string
+		said   string
+	}{
+		{"a desk pull on a work branch", "work/g", []string{"pull"}, "the pull hands nothing out on work/g."},
+		{"a desk pull naming a group on trunk", "main", []string{"pull", "g"}, "the pull takes no branch for g."},
+	}
+	for _, one := range cases {
+		t.Run(one.name, func(t *testing.T) {
+			t.Parallel()
+			it, errs, logged := raisingPull(t, failure.Node{ID: "desk-works-on-trunk", Level: "warn", Remedies: []string{remedy}})
+			if one.branch == "main" {
+				gitIn(t, it.Root, "switch", "-q", "main")
+			}
+			it.Cloud = false
+			it.Take = func(string) int { return 0 }
+			code := it.Pulling(one.argv)
+			if code != 2 || !strings.Contains(errs(), "so "+one.said) {
+				t.Fatalf("the pull answers %d, and lacks %q:\n%s", code, one.said, errs())
+			}
+			if count := strings.Count(errs(), remedy); count != 1 {
+				t.Fatalf("the pull prints the remedy %d times:\n%s", count, errs())
+			}
+			if strings.Join(*logged, ",") != "warn desk-works-on-trunk" {
+				t.Fatalf("the log takes %q", *logged)
+			}
+		})
+	}
+}
