@@ -0,0 +1,36 @@
+package main
+
+import (
+	"encoding/json"
+
+	logmodule "quackitect/src/modules/log"
+)
+
+// The config key the box's floor reads, and the floor a box holds when the config names none. [[spec/design_output/log#what-a-box-writes]]
+const (
+	floorKey     = "log.level"
+	floorDefault = "info"
+)
+
+// Drops a row ranked below the floor, and hands every other row to write. [[spec/design_output/log#which-kind-says-what]]
+func keepsFloor(floor string, write func(row map[string]any) error) func(row map[string]any) error {
+	return func(row map[string]any) error {
+		level, _ := row["level"].(string)
+		if logmodule.Rank(level) < logmodule.Rank(floor) {
+			return nil
+		}
+		return write(row)
+	}
+}
+
+func boxFloor(root string) string {
+	rows, err := configAt(root)
+	if err != nil {
+		return floorDefault
+	}
+	var floor string
+	if json.Unmarshal(rows[floorKey].Value, &floor) != nil || floor == "" {
+		return floorDefault
+	}
+	return floor
+}
diff --git a/src/quack/floor_test.go b/src/quack/floor_test.go
new file mode 100644
index 0000000..6fa4c11
--- /dev/null
+++ b/src/quack/floor_test.go
@@ -0,0 +1,54 @@
+package main
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestKeepsFloorDropsEveryRowBelowTheFloor(t *testing.T) {
+	cases := []struct {
+		name  string
+		floor string
+		level string
+		kept  bool
+	}{
+		{"a debug row under an info floor is dropped", "info", "debug", false},
+		{"an info row at an info floor is kept", "info", "info", true},
+		{"a warn row over an info floor is kept", "info", "warn", true},
+		{"a debug row at a debug floor is kept", "debug", "debug", true},
+		{"a warn row at an error floor is dropped", "error", "warn", false},
+		{"a level nobody knows ranks as info, so it is kept at an info floor", "info", "loud", true},
+		{"a level nobody knows is dropped at an error floor", "error", "loud", false},
+		{"a row with no level ranks as info, so it is kept at an info floor", "info", "", true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			var written []map[string]any
+			write := func(row map[string]any) error {
+				written = append(written, row)
+				return nil
+			}
+			row := map[string]any{"level": c.level, "kind": "lint", "said": "x"}
+			if err := keepsFloor(c.floor, write)(row); err != nil {
+				t.Fatalf("the floor answers an error %v where the write answers none", err)
+			}
+			if got := len(written) == 1; got != c.kept {
+				t.Fatalf("a %q row at a %q floor: kept is %v, and wants %v", c.level, c.floor, got, c.kept)
+			}
+		})
+	}
+}
+
+func TestBoxFloorDefaultsToInfoWhereTheConfigNamesNone(t *testing.T) {
+	if got := boxFloor(t.TempDir()); got != "info" {
+		t.Fatalf("a box with no config floors at info, and reads %q", got)
+	}
+}
+
+func TestKeepsFloorAnswersTheWritesError(t *testing.T) {
+	boom := errors.New("boom")
+	write := func(map[string]any) error { return boom }
+	if err := keepsFloor("info", write)(map[string]any{"level": "warn"}); err != boom {
+		t.Fatalf("a kept row answers the write's error, and reads %v", err)
+	}
+}
