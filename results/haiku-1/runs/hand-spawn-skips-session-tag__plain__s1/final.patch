+// A helper spawn whose prompt opens on the hand of its own takes no session tag, with no own field set, so the pull's own spawn reads no --as against its prompt. [[spec/design_output/pull#a-hand-of-its-own]]
+// level0: FixtureOutsideHome - the spawn seeds the session file into a root of its own, as the case above does.
+func TestASpawnOpeningOnAHandOfItsOwnTakesNoTag(t *testing.T) {
+	prompt := q.HandOfItsOwn + ", named w1, and you work one step of one ticket."
+	root := treeOf(t, map[string]string{sessionFile: `{"id":"s7","harness":"claude-code"}`}, "")
+	door := holdDoor(t, Settings{Words: nameWords, Binding: queueBinding, BindingLayer: builtInLayer})
+	said, err := door.Hook(Post{Event: spawnEvent, Root: root, E: map[string]any{
+		"session_id": "s1", "prompt": prompt,
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, effect := range said.Effects {
+		if event, ok := effect.Result.(map[string]any); ok && effect.Kind == eventEffect {
+			t.Fatalf("a spawn opening on the hand of its own answers %+v, and wants no event, since no tag stands", event)
+		}
+	}
+}
