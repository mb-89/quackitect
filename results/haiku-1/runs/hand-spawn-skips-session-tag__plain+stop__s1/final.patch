+// A spawn whose prompt opens on the hand line a hand of its own takes reads no session tag, own field or none. [[spec/design_output/pull#a-hand-of-its-own]]
+// level0: FixtureOutsideHome - the case seeds the session file into a tree of its own.
+func TestASpawnOfAHandOfItsOwnTakesNoSessionTag(t *testing.T) {
+	const line = q.HandOfItsOwn + ", named s1-1, and you work one step of one ticket."
+	for _, one := range []struct {
+		name string
+		own  any
+	}{
+		{"no own field", nil},
+		{"the own field set", true},
+	} {
+		t.Run(one.name, func(t *testing.T) {
+			root := treeOf(t, map[string]string{sessionFile: `{"id":"s7","harness":"claude-code"}`}, "")
+			door := holdDoor(t, Settings{Words: nameWords, Binding: queueBinding, BindingLayer: builtInLayer})
+			E := map[string]any{"session_id": "s1", "prompt": line}
+			if one.own != nil {
+				E[ownField] = one.own
+			}
+			said, err := door.Hook(Post{Event: spawnEvent, Root: root, E: E})
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, effect := range said.Effects {
+				if event, ok := effect.Result.(map[string]any); ok && effect.Kind == eventEffect {
+					if got := textOf(event, "prompt"); strings.Contains(got, "hand of session") {
+						t.Fatalf("the spawn's prompt reads %q, and wants no session tag", got)
+					}
+				}
+			}
+		})
+	}
+}
