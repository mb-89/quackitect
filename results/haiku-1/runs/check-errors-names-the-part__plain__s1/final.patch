+// The verb door over a run: the words join the road and run under the env, and a quiet run that answers red writes what it said to the error stream, where its why stands. A run that cannot start is named there too. [[spec/tickets/check-errors-names-the-part]]
+func verbOver(run func(argv, env []string, quiet bool) (int, string, error), road, env []string, errs io.Writer) func(words []string, quiet bool) int {
+	return func(words []string, quiet bool) int {
+		code, said, err := run(slices.Concat(road, words), env, quiet)
+		if err != nil {
+			fmt.Fprintln(errs, err)
+			return exitFailed
+		}
+		if quiet && code != 0 && strings.TrimSpace(said) != "" {
+			fmt.Fprintln(errs, strings.TrimSpace(said))
+		}
+		return code
+	}
+}
