+func TestCheckQuietStreams(t *testing.T) {
+	t.Run("a quiet red build keeps its output as the why, where no test failed", func(t *testing.T) {
+		fake := &checkFake{codes: map[string]int{"go": 1}, said: map[string]string{"go": "# quackitect/src/quack\nsrc/quack/a.go:3: undefined: x\n"}}
+		doors := fake.doors()
+		var errs strings.Builder
+		doors.errs = &errs
+		if code := goGate(doors, true, nil); code != 1 {
+			t.Fatalf("a red build answers %d", code)
+		}
+		if errs.String() != "# quackitect/src/quack\nsrc/quack/a.go:3: undefined: x\n" {
+			t.Fatalf("the error stream reads %q", errs.String())
+		}
+	})
+	t.Run("under --errors a part's own line reaches the error stream, and stdout holds the rows alone", func(t *testing.T) {
+		fake := &checkFake{said: map[string]string{"gofmt": "src/a.go\n"}}
+		doors := fake.doors()
+		doors.root = t.TempDir()
+		var out, errs strings.Builder
+		doorsOf := func(o, e io.Writer) checkDoors { doors.out, doors.errs = o, e; return doors }
+		if code := checkVerb(doorsOf)([]string{"check", "--errors"}, false, &out, &errs); code != 1 {
+			t.Fatalf("the check answers %d, and a gofmt fault is red", code)
+		}
+		if strings.TrimSpace(out.String()) != noErrors {
+			t.Fatalf("the stdout reads %q, and wants the rows alone", out.String())
+		}
+		if !strings.Contains(errs.String(), "src/a.go: Gofmt:") {
+			t.Fatalf("the error stream reads %q, and wants the gofmt line", errs.String())
+		}
+	})
+}
