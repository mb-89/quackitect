+func TestVerbOver(t *testing.T) {
+	t.Run("the words join the road, and the env and the quiet flag pass through", func(t *testing.T) {
+		var argv, env []string
+		var quiet bool
+		run := func(a, e []string, q bool) (int, string, error) { argv, env, quiet = a, e, q; return 0, "", nil }
+		road := []string{"quack", "verb", "scripts"}
+		verb := verbOver(run, road, []string{"LINT=found"}, io.Discard)
+		if code := verb([]string{"lint", "src"}, true); code != 0 {
+			t.Fatalf("a green run answers %d", code)
+		}
+		if !reflect.DeepEqual(argv, []string{"quack", "verb", "scripts", "lint", "src"}) || !reflect.DeepEqual(env, []string{"LINT=found"}) || !quiet {
+			t.Fatalf("the run reached %v under %v, quiet %v", argv, env, quiet)
+		}
+		if !reflect.DeepEqual(road, []string{"quack", "verb", "scripts"}) {
+			t.Fatalf("the road reads %v after the run", road)
+		}
+	})
+	t.Run("a quiet red run writes its why to the error stream", func(t *testing.T) {
+		run := func([]string, []string, bool) (int, string, error) { return 1, "src/a.go: it broke\n", nil }
+		var errs strings.Builder
+		if code := verbOver(run, []string{"quack"}, nil, &errs)([]string{"lint"}, true); code != 1 {
+			t.Fatalf("a red run answers %d", code)
+		}
+		if errs.String() != "src/a.go: it broke\n" {
+			t.Fatalf("the error stream reads %q", errs.String())
+		}
+	})
+	t.Run("a quiet green run keeps its output off the error stream", func(t *testing.T) {
+		run := func([]string, []string, bool) (int, string, error) { return 0, "chatter\n", nil }
+		var errs strings.Builder
+		if code := verbOver(run, []string{"quack"}, nil, &errs)([]string{"lint"}, true); code != 0 || errs.Len() != 0 {
+			t.Fatalf("a green run answers %d, and the error stream reads %q", code, errs.String())
+		}
+	})
+	t.Run("a run that is not quiet writes nothing itself", func(t *testing.T) {
+		run := func([]string, []string, bool) (int, string, error) { return 1, "said\n", nil }
+		var errs strings.Builder
+		if code := verbOver(run, []string{"quack"}, nil, &errs)([]string{"lint"}, false); code != 1 || errs.Len() != 0 {
+			t.Fatalf("a loud red run answers %d, and the error stream reads %q", code, errs.String())
+		}
+	})
+	t.Run("a run that cannot start names the error, and fails", func(t *testing.T) {
+		run := func([]string, []string, bool) (int, string, error) { return 0, "", errors.New("no quack") }
+		var errs strings.Builder
+		if code := verbOver(run, []string{"quack"}, nil, &errs)([]string{"lint"}, true); code != exitFailed || errs.String() != "no quack\n" {
+			t.Fatalf("the run answers %d, and the error stream reads %q", code, errs.String())
+		}
+	})
+}
