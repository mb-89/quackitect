+func TestTicketSetRefusesClosedGroup(t *testing.T) {
+	shut := "---\nkind: [[ticket]]\nstate: closed\nsteps:\n  - name: do\n    does: makes the change\nstep: do\n---\n\n# Ask\n\nA group.\n"
+	t.Run("set refuses a closed group and writes nothing", func(t *testing.T) {
+		root := editCaseTree(t, "a-thing")
+		seedsFile(t, root, "spec/tickets/shut.md", shut)
+		code, out, errs := runsApart(t, root, false, "ticket", "set", "a-thing", "group", "shut")
+		if code != exitUsage || out != "" || !strings.HasPrefix(errs, "shut stands closed, so it takes no new child.") {
+			t.Fatalf("set answers %d, %q, %q", code, out, errs)
+		}
+		if got, _ := readsBack(t, root, aThing); strings.Contains(got, "group: shut") {
+			t.Fatalf("the ticket took the closed group: %q", got)
+		}
+	})
+	t.Run("set writes a group that stands open", func(t *testing.T) {
+		root := editCaseTree(t, "a-thing")
+		seedsFile(t, root, "spec/tickets/open-one.md", strings.Replace(shut, "state: closed", "state: open", 1))
+		code, _, errs := runsApart(t, root, false, "ticket", "set", "a-thing", "group", "open-one")
+		if got, _ := readsBack(t, root, aThing); code != 0 || errs != "" || !strings.Contains(got, "\ngroup: open-one\n") {
+			t.Fatalf("set answers %d, %q; the ticket holds %q", code, errs, got)
+		}
+	})
+}
