+func valeCalls(calls []string) int {
+	n := 0
+	for _, call := range calls {
+		if strings.HasPrefix(call, "vale ") {
+			n++
+		}
+	}
+	return n
+}
+
+func TestAValeBusyAnswerGoesAgain(t *testing.T) {
+	busy := `{"Code": "E201", "Text": "Vale is busy\nmore"}`
+	fake := &fakeTools{
+		says:   map[string]string{"vale": valeSays("/tree/spec/b.md", "VoiceVale.Sentence", "Some")},
+		queued: map[string][]string{"vale": {busy}},
+	}
+	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n\nSome text\n"}, fake)
+	if drawn := drawnOn(server.SweepTools(), "file:///tree/spec/b.md"); !holds(drawn, "vale", "Sentence") {
+		t.Fatalf("the file draws %+v, and wants the Vale row once the busy run goes again", drawn)
+	}
+	if runs := valeCalls(fake.calls); runs != 2 {
+		t.Fatalf("vale runs %d times, and wants 2: one busy, one with rows", runs)
+	}
+}
+
+func TestAValeBusyRunStopsAtTheBound(t *testing.T) {
+	busy := `{"Code": "E201", "Text": "Vale is busy"}`
+	queued := make([]string, valeTries)
+	for i := range queued {
+		queued[i] = busy
+	}
+	fake := &fakeTools{queued: map[string][]string{"vale": queued}}
+	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n"}, fake)
+	if drawn := drawnOn(server.SweepTools(), "file:///tree/.vale.ini"); !holds(drawn, "vale", "ValeRuns") {
+		t.Fatalf("the config draws %+v, and wants ValeRuns once the bound is spent", drawn)
+	}
+	if runs := valeCalls(fake.calls); runs != valeTries {
+		t.Fatalf("vale runs %d times, and wants valeTries (%d)", runs, valeTries)
+	}
+}
+
+func TestAValeBusyErrorOnStderrGoesAgain(t *testing.T) {
+	busy := errors.New(`exit status 2: {"Code": "E201", "Text": "did not finish within 2s"}`)
+	fake := &fakeTools{fails: map[string]error{"vale": busy}}
+	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n"}, fake)
+	if drawn := drawnOn(server.SweepTools(), "file:///tree/.vale.ini"); !holds(drawn, "vale", "ValeRuns") {
+		t.Fatalf("the config draws %+v, and wants ValeRuns once the stderr busy runs spend the bound", drawn)
+	}
+	if runs := valeCalls(fake.calls); runs != valeTries {
+		t.Fatalf("vale runs %d times on stderr E201, and wants valeTries (%d)", runs, valeTries)
+	}
+}
