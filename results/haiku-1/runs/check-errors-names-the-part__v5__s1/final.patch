diff --git a/src/quack/verbover_test.go b/src/quack/verbover_test.go
new file mode 100644
index 0000000..7fb0d96
--- /dev/null
+++ b/src/quack/verbover_test.go
@@ -0,0 +1,39 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"reflect"
+	"testing"
+)
+
+// A verb over the road hands its why to errs under quiet when it is red, and says nothing when green. [[spec/tickets/check-errors-names-the-part]]
+func TestVerbOverHandsItsWhy(t *testing.T) {
+	cases := []struct {
+		claim string
+		code  int
+		said  string
+		err   error
+		quiet bool
+		want  string
+		wcode int
+	}{
+		{"a red quiet run names why it failed", 1, "why line\n", nil, true, "why line\n", 1},
+		{"a green quiet run says nothing", 0, "part lines\n", nil, true, "", 0},
+		{"a red run not quiet already printed its output", 1, "", nil, false, "", 1},
+		{"a run that does not start names its error", 0, "", errors.New("boom"), true, "boom\n", exitFailed},
+	}
+	for _, one := range cases {
+		var errs bytes.Buffer
+		run := func(argv, env []string, quiet bool) (int, string, error) {
+			if !reflect.DeepEqual(argv, []string{"self", "verb", "scripts", "lint", "src"}) || quiet != one.quiet {
+				t.Errorf("%s: run gets %v quiet %v", one.claim, argv, quiet)
+			}
+			return one.code, one.said, one.err
+		}
+		code := verbOver(run, []string{"self", "verb", "scripts"}, []string{"LINT=x"}, &errs)([]string{"lint", "src"}, one.quiet)
+		if code != one.wcode || errs.String() != one.want {
+			t.Errorf("%s: answers %d with %q, want %d with %q", one.claim, code, errs.String(), one.wcode, one.want)
+		}
+	}
+}
