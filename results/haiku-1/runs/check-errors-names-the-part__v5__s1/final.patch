+// A verb run through quack's own road. Under quiet a red run hands its output to errs, the why it failed, and a run that does not start hands its error. [[spec/tickets/check-errors-names-the-part]]
+func verbOver(run func(argv, env []string, quiet bool) (int, string, error), road, env []string, errs io.Writer) func(words []string, quiet bool) int {
+	return func(words []string, quiet bool) int {
+		code, said, err := run(append(append([]string{}, road...), words...), env, quiet)
+		if err != nil {
+			fmt.Fprintln(errs, err)
+			return exitFailed
+		}
+		if quiet && code != 0 {
+			fmt.Fprint(errs, said)
+		}
+		return code
+	}
+}
