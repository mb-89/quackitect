+// The desk pull's refusal prints the node's remedy once, as the take does. [[spec/tickets/the-twins-leave-whole]]
+func TestDeskPullPrintsTheRemedyOnce(t *testing.T) {
+	t.Parallel()
+	remedy := "Run git switch main, and take a finished cloud branch in with ./RUNME.sh branch merge g."
+	cases := []struct {
+		name  string
+		argv  []string
+		trunk bool
+	}{
+		{"a desk pull on a work branch", []string{"pull"}, false},
+		{"a desk pull naming a group on trunk", []string{"pull", "g"}, true},
+	}
+	for _, one := range cases {
+		t.Run(one.name, func(t *testing.T) {
+			t.Parallel()
+			it, errs, _ := raisingPull(t, failure.Node{ID: "desk-works-on-trunk", Level: "warn", Remedies: []string{remedy}})
+			it.Cloud = false
+			if one.trunk {
+				gitIn(t, it.Root, "switch", "-q", "main")
+				it.Take = func(string) int { return 0 }
+			}
+			if code := it.Pulling(one.argv); code != 2 {
+				t.Fatalf("the pull answers %d:\n%s", code, errs())
+			}
+			if count := strings.Count(errs(), "git switch main"); count != 1 {
+				t.Fatalf("the pull prints the remedy %d times:\n%s", count, errs())
+			}
+		})
+	}
+}
