diff --git a/src/pull/shell_test.go b/src/pull/shell_test.go
index c777693..b88518e 100644
--- a/src/pull/shell_test.go
+++ b/src/pull/shell_test.go
@@ -56,3 +56,14 @@ func TestTheShellRunsALineThroughShInTheRootAndReadsAProgramThatNeverStartsAsAFa
 		t.Error("the shell reads a program that never starts as no fault")
 	}
 }
+
+func TestTheShellReadsALineASignalEndsAsAFault(t *testing.T) {
+	t.Parallel()
+	killed := &proc.FakeRunner{Programs: map[string]proc.Program{"sh": func(proc.Command) proc.Said {
+		return proc.Said{Err: "killed\n", Code: proc.Signalled}
+	}}}
+	out, exit, err := ShellOver(killed.Run, "the/root")("kill -TERM $$")
+	if err == nil || err.Error() != "killed\n" || out != "" || exit != 0 {
+		t.Errorf("the shell reads a signal's end as %q, %d, %v, and wants the fault", out, exit, err)
+	}
+}
