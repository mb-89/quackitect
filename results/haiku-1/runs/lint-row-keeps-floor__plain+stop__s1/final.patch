+// The log's floor under the root, off the config's log.level, and empty where nothing answers it, which ranks as info. [[spec/design_output/log#what-a-box-writes]]
+func logFloor(root string) string {
+	rows, err := configAt(root)
+	if err != nil {
+		return ""
+	}
+	var floor string
+	if json.Unmarshal(rows["log.level"].Value, &floor) != nil {
+		return ""
+	}
+	return floor
+}
+
+// Writes a row only where its level stands at the floor or above it, as the JavaScript log door writes its rows. [[spec/design_output/log#what-a-box-writes]]
+func keepsFloor(floor string, write func(row map[string]any) error) func(row map[string]any) error {
+	return func(row map[string]any) error {
+		level, _ := row["level"].(string)
+		if logmodule.Rank(level) < logmodule.Rank(floor) {
+			return nil
+		}
+		return write(row)
+	}
+}
