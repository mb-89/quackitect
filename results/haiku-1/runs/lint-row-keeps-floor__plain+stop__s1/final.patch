+// The floor reads the log's level off the config under the root. [[spec/design_output/log#what-a-box-writes]]
+func TestTheFloorReadsTheLogLevelOffTheTrackedFile(t *testing.T) {
+	root := t.TempDir()
+	at := filepath.Join(root, "spec", "config")
+	if err := os.MkdirAll(at, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(at, "level0.json"), []byte(`{"log": {"level": "warn"}}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if said := logFloor(root); said != "warn" {
+		t.Fatalf("the root reads %q, and wants warn", said)
+	}
+}
+
+// A row writes only where its level stands at the floor or above it, and an unknown floor reads as info. [[spec/design_output/log#what-a-box-writes]]
+func TestKeepsFloorWritesOnlyRowsAtOrAboveTheFloor(t *testing.T) {
+	cases := []struct {
+		floor, level string
+		kept         bool
+	}{
+		{"info", "debug", false},
+		{"info", "info", true},
+		{"warn", "debug", false},
+		{"warn", "info", false},
+		{"warn", "warn", true},
+		{"warn", "fatal", true},
+		{"debug", "debug", true},
+		{"", "debug", false},
+		{"", "info", true},
+		{"nonsense", "debug", false},
+	}
+	for _, one := range cases {
+		var rows []map[string]any
+		write := keepsFloor(one.floor, func(row map[string]any) error {
+			rows = append(rows, row)
+			return nil
+		})
+		if err := write(map[string]any{"level": one.level, "kind": "vale"}); err != nil {
+			t.Fatal(err)
+		}
+		if got := len(rows) == 1; got != one.kept {
+			t.Fatalf("floor %q, level %q: kept %v, wants %v", one.floor, one.level, got, one.kept)
+		}
+	}
+}
+
+// A row the floor drops answers no error and reaches no writer, and a row it keeps reaches the writer's error. [[spec/tickets/read-verbs-port-to-go]]
+func TestKeepsFloorPassesTheWritersError(t *testing.T) {
+	fault := errors.New("disk full")
+	write := keepsFloor("info", func(map[string]any) error { return fault })
+	if err := write(map[string]any{"level": "debug"}); err != nil {
+		t.Fatalf("a dropped row answers %v", err)
+	}
+	if err := write(map[string]any{"level": "warn"}); err != fault {
+		t.Fatalf("a kept row answers %v, and wants the writer's fault", err)
+	}
+}
