+
+func TestVoiceRunsValeAnswersTheFaultOfAValeEndedBySignal(t *testing.T) {
+	t.Parallel()
+	fake := &proc.FakeRunner{Programs: map[string]proc.Program{taughtVale: func(proc.Command) proc.Said {
+		return proc.Said{Out: "{", Err: "killed", Code: proc.Signalled}
+	}}}
+	said, err := voiceRunsValeOver(fake.Run)([]string{taughtVale}, t.TempDir())
+	if err == nil || !strings.Contains(err.Error(), "signal") || !strings.Contains(err.Error(), "killed") || said != "" {
+		t.Fatalf("a Vale ended by a signal answers %q %v, and wants its signal fault", said, err)
+	}
+}
