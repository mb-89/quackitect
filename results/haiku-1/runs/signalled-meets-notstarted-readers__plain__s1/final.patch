@@ -56,3 +56,14 @@ func TestTheShellRunsALineThroughShInTheRootAndReadsAProgramThatNeverStartsAsAFa
 		t.Error("the shell reads a program that never starts as no fault")
 	}
 }
+
+func TestTheShellAnswersTheFaultOfALineEndedBySignal(t *testing.T) {
+	t.Parallel()
+	sh := &proc.FakeRunner{Programs: map[string]proc.Program{"sh": func(proc.Command) proc.Said {
+		return proc.Said{Out: "said\n", Code: proc.Signalled}
+	}}}
+	out, exit, err := ShellOver(sh.Run, "the/root")("echo said; kill -TERM $$")
+	if out != "" || exit != 0 || err == nil || !strings.Contains(err.Error(), "signal") {
+		t.Errorf("the shell answers %q, %d, %v, and wants a signal's fault and no code", out, exit, err)
+	}
+}
