+// A lint's passing row, at debug, stays off the session log under a floor of info, reaches it once the floor drops to debug, and a warning reaches it under either. [[spec/design_output/log#which-kind-says-what]]
+func TestTheSessionLogHoldsNoRowBelowTheFloor(t *testing.T) {
+	root := t.TempDir()
+	at := filepath.Join(root, "spec", "config")
+	if err := os.MkdirAll(at, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(at, "level0.json"), []byte(`{"log": {"level": "info"}}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	write := appendsRow(root, time.Now)
+	if err := write(map[string]any{"level": "debug", "kind": "vale", "said": "the rules pass over ."}); err != nil {
+		t.Fatal(err)
+	}
+	logged := filepath.Join(root, filepath.FromSlash(sessionLog))
+	if body, _ := os.ReadFile(logged); len(body) != 0 {
+		t.Fatalf("a debug row under an info floor lands as %q", body)
+	}
+	if err := write(map[string]any{"level": "warn", "kind": "vale", "said": "1 line(s) break a rule"}); err != nil {
+		t.Fatal(err)
+	}
+	if body, _ := os.ReadFile(logged); !strings.Contains(string(body), `"level":"warn"`) {
+		t.Fatalf("a warn row under an info floor lands as %q, and wants it kept", body)
+	}
+	if err := os.WriteFile(filepath.Join(at, "level0.json"), []byte(`{"log": {"level": "debug"}}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := write(map[string]any{"level": "debug", "kind": "vale", "said": "the rules pass over ."}); err != nil {
+		t.Fatal(err)
+	}
+	if body, _ := os.ReadFile(logged); !strings.Contains(string(body), `"level":"debug"`) {
+		t.Fatalf("a debug row under a debug floor lands as %q, and wants it kept: the floor is read per row", body)
+	}
+}
