+// The floor keeps a row at its level and above, and drops one below it, and a level nobody knows or a floor nobody sets ranks as info. [[spec/design_output/log#what-a-box-writes]]
+func TestTheFloorKeepsRowsAtAndAboveIt(t *testing.T) {
+	cases := []struct {
+		floor, level string
+		kept         bool
+	}{
+		{"info", "debug", false},
+		{"info", "info", true},
+		{"info", "warn", true},
+		{"warn", "info", false},
+		{"warn", "error", true},
+		{"error", "warn", false},
+		{"fatal", "error", false},
+		{"fatal", "fatal", true},
+		{"", "debug", false},
+		{"", "info", true},
+		{"info", "nobody-knows", true},
+		{"nobody-knows", "debug", false},
+		{"info", "", true},
+	}
+	for _, one := range cases {
+		var got []map[string]any
+		write := keepsFloor(one.floor, func(row map[string]any) error {
+			got = append(got, row)
+			return nil
+		})
+		if err := write(map[string]any{"level": one.level, "said": "x"}); err != nil {
+			t.Fatal(err)
+		}
+		if kept := len(got) == 1; kept != one.kept {
+			t.Errorf("floor %q keeps a %q row %v, and wants %v", one.floor, one.level, kept, one.kept)
+		}
+	}
+}
