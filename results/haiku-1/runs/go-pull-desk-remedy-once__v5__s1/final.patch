+func TestADeskPullOnAWorkBranchPrintsItsRemedyOnce(t *testing.T) {
+	t.Parallel()
+	it, errs, logged := raisingPull(t, failure.Node{ID: "desk-works-on-trunk", Level: "warn", Remedies: []string{"Run git switch main, and take a finished cloud branch in with ./RUNME.sh branch merge <name>."}})
+	it.Cloud = false
+	code := it.Pulling([]string{"pull"})
+	if code != 2 || strings.Count(errs(), "git switch main") != 1 {
+		t.Fatalf("the pull answers %d, and prints the remedy other than once:\n%s", code, errs())
+	}
+	if strings.Join(*logged, ",") != "warn desk-works-on-trunk" {
+		t.Fatalf("the log takes %q", *logged)
+	}
+}
