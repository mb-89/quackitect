+// A binary that cannot step aside, because its name and every aside name stand as folders, fails the swap: the rows print, the error says so, and the run fails without asking for Go. [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiSwapFailurePrintsTheRowsAndFailsLoud(t *testing.T) {
+	box := tuiBoxAt(t)
+	files := map[string]string{".se/.log/session.jsonl": tuiRowText}
+	held := []string{box.exe(), box.exe() + ".old"}
+	for n := 1; n < tuiAside; n++ {
+		held = append(held, fmt.Sprintf("%s.old%d", box.exe(), n))
+	}
+	for _, folder := range held {
+		files[strings.TrimPrefix(folder, box.root+"/")+"/held"] = "held"
+	}
+	tuiWrites(t, box.root, files)
+	if exe, why, err := tuiViewerOf(box.doors()); exe != "" || why != "" || err == nil {
+		t.Fatalf("exe %q, why %q, err %v", exe, why, err)
+	}
+	code, out, errs := box.runs()
+	want := ".se/.log/session.jsonl\n" + strings.Join(tuiRowsSaid, "\n") + "\n"
+	if code != exitFailed || out != want {
+		t.Fatalf("code %d\nout %q\nwant %q", code, out, want)
+	}
+	if !strings.HasPrefix(errs, "the fresh viewer fails to swap in: ") {
+		t.Errorf("errs %q names no swap", errs)
+	}
+}
