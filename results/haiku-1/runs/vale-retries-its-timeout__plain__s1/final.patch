--- a/src/modules/lsp/tools_test.go
+++ b/src/modules/lsp/tools_test.go
@@ -20,6 +20,8 @@ type fakeTools struct {
 	says  map[string]string
 	fails map[string]error
 	calls []string
+	// The Vale runs that answer E201 before the rest answer as says names. [[spec/tickets/vale-retries-its-timeout]]
+	timeouts int
 }
 
 func (one *fakeTools) run(dir, input, name string, argv ...string) (string, error) {
@@ -29,9 +31,26 @@ func (one *fakeTools) run(dir, input, name string, argv ...string) (string, erro
 	if err := one.fails[name]; err != nil {
 		return "", err
 	}
+	if name == "vale" && one.timeouts > 0 {
+		one.timeouts--
+		return `{"Code": "E201", "Text": "a script rule passed its cap"}`, nil
+	}
 	return one.says[name], nil
 }
 
+// The Vale runs the fake took, which a case reads to count the goes again. [[spec/tickets/vale-retries-its-timeout]]
+func (one *fakeTools) valeRuns() int {
+	one.mu.Lock()
+	defer one.mu.Unlock()
+	runs := 0
+	for _, call := range one.calls {
+		if strings.HasPrefix(call, "vale ") {
+			runs++
+		}
+	}
+	return runs
+}
