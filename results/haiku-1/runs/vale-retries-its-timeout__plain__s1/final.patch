+func TestAValeTimeoutGoesAgainAndDrawsTheRows(t *testing.T) {
+	fake := &fakeTools{timeouts: 1, says: map[string]string{"vale": valeSays("/tree/spec/b.md", "VoiceVale.Sentence", "Some")}}
+	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n\nSome text\n"}, fake)
+	drawn := drawnOn(server.SweepTools(), "file:///tree/spec/b.md")
+	if !holds(drawn, "vale", "Sentence") {
+		t.Fatalf("the file draws %+v, and wants the Vale row once Vale answers past its timeout", drawn)
+	}
+	if holds(drawn, "vale", "ValeRuns") {
+		t.Fatalf("the file draws %+v, and wants no ValeRuns fault for a timeout that passes", drawn)
+	}
+	if runs := fake.valeRuns(); runs != 2 {
+		t.Fatalf("vale runs %d times, and wants 2: the timeout, then the rows", runs)
+	}
+}
+
+func TestAValeTimeoutGivesUpAfterValeTries(t *testing.T) {
+	fake := &fakeTools{timeouts: valeTries + 1, says: map[string]string{"vale": valeSays("/tree/spec/b.md", "VoiceVale.Sentence", "Some")}}
+	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n\nSome text\n"}, fake)
+	if drawn := drawnOn(server.SweepTools(), "file:///tree/.vale.ini"); !holds(drawn, "vale", "ValeRuns") {
+		t.Fatalf("the config draws %+v, and wants ValeRuns once every run times out", drawn)
+	}
+	if runs := fake.valeRuns(); runs != valeTries {
+		t.Fatalf("vale runs %d times, and wants %d, the bound", runs, valeTries)
+	}
+}
+
 func TestAValeFaultDrawsValeRuns(t *testing.T) {
 	fake := &fakeTools{fails: map[string]error{"vale": errors.New("E100 the config breaks")}}
 	server, _ := toolsOver(t, map[string]string{"spec/b.md": "# B\n"}, fake)
