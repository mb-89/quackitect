@@ -38,6 +38,12 @@ var (
 	proseKind = regexp.MustCompile(`^Voice(Vale|Paragraph)\.`)
 )
 
+// The code Vale names when a script rule passes its own cap, which a run under the parts' load does, and the runs a Vale run takes before it gives up on that code. The contract case on Vale paths takes the same count. [[spec/tickets/vale-retries-its-timeout]]
+const (
+	valeTimeout = "E201"
+	valeTries   = 3
+)
+
 // A tool run: the folder, the input, the binary and its words. The door runs one, and a case hands in its own. [[spec/tickets/lsp-module-draws-the-tools]]
 type Runner func(dir, input, name string, argv ...string) (string, error)
 
@@ -214,14 +220,26 @@ func (one *Tools) vale(tree Tree, disk, held []string) []Finding {
 	return one.vetoes(tree, heard)
 }
 
+// A Vale run goes again while Vale names its timeout, up to valeTries runs, and the last answer stands. [[spec/tickets/vale-retries-its-timeout]]
 func (one *Tools) valeRun(input string, argv []string) ([]valeHeard, string) {
 	out, err := one.Run(one.Root, input, one.Vale, argv...)
+	for at := 1; at < valeTries && timedOut(out, err); at++ {
+		out, err = one.Run(one.Root, input, one.Vale, argv...)
+	}
 	if err != nil {
 		return nil, err.Error()
 	}
 	return one.valeRowsOf(out)
 }
 
+// Whether a run's answer or its error names Vale's timeout. [[spec/tickets/vale-retries-its-timeout]]
+func timedOut(stdout string, err error) bool {
+	if err != nil && strings.Contains(err.Error(), valeTimeout) {
+		return true
+	}
+	return strings.Contains(stdout, valeTimeout)
+}
+
 func (one *Tools) valeFault(why string) Finding {
 	return Finding{File: one.Config, Rule: ValeRuns, Line: 1, Column: 1, Message: "Vale reads no file, so every rule it holds stands unchecked: " + why, Severity: severe, Source: fromVale}
 }
diff --git a/src/modules/lsp/tools_test.go b/src/modules/lsp/tools_test.go
