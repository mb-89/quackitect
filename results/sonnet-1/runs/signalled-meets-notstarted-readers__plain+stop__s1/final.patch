+func TestTheShellReadsARunASignalEndsAsAFault(t *testing.T) {
+	t.Parallel()
+	sh := &proc.FakeRunner{Programs: map[string]proc.Program{"sh": func(proc.Command) proc.Said {
+		return proc.Said{Err: "killed", Code: proc.Signalled}
+	}}}
+	if _, _, err := ShellOver(sh.Run, "the/root")("sleep 9"); err == nil {
+		t.Error("the shell reads a run a signal ends as no fault")
+	}
+}
