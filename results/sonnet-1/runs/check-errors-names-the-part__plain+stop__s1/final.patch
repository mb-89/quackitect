+// A verb through quack's own road over the run door. A quiet red run leaves what the verb said on the error stream, so the part's failure keeps its reason. [[spec/design_output/work#the-battery-answers-first]]
+func verbOver(run func(argv, env []string, quiet bool) (int, string, error), road, env []string, errs io.Writer) func(words []string, quiet bool) int {
+	return func(words []string, quiet bool) int {
+		code, said, err := run(append(slices.Clone(road), words...), env, quiet)
+		if err != nil {
+			fmt.Fprintln(errs, err)
+			return exitFailed
+		}
+		if quiet && code != 0 && strings.TrimSpace(said) != "" {
+			fmt.Fprintln(errs, strings.TrimSpace(said))
+		}
+		return code
+	}
+}
