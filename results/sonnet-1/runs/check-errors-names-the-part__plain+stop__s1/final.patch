+++ b/src/quack/verbover_test.go
@@ -0,0 +1,36 @@
+package main
+
+import (
+	"bytes"
+	"slices"
+	"strings"
+	"testing"
+)
+
+// A quiet red verb leaves its words on the error stream; a quiet green one and a loud red one leave none. [[spec/design_output/work#the-battery-answers-first]]
+func TestVerbOverQuietRedSaysWhy(t *testing.T) {
+	var got []string
+	run := func(code int, said string) func(argv, env []string, quiet bool) (int, string, error) {
+		return func(argv, env []string, quiet bool) (int, string, error) {
+			got = argv
+			return code, said, nil
+		}
+	}
+	cases := []struct {
+		code  int
+		quiet bool
+		want  string
+	}{{1, true, "why it failed\n"}, {0, true, ""}, {1, false, ""}}
+	for _, c := range cases {
+		var errs bytes.Buffer
+		code := verbOver(run(c.code, "why it failed\n"), []string{"self", "verb"}, nil, &errs)([]string{"lint", "."}, c.quiet)
+		if code != c.code || errs.String() != c.want || !slices.Equal(got, []string{"self", "verb", "lint", "."}) {
+			t.Errorf("code %d quiet %v: got %d %q %v", c.code, c.quiet, code, errs.String(), got)
+		}
+	}
+	var errs bytes.Buffer
+	failing := func(argv, env []string, quiet bool) (int, string, error) { return 0, "", bytes.ErrTooLarge }
+	if verbOver(failing, nil, nil, &errs)(nil, true) != exitFailed || !strings.Contains(errs.String(), "too large") {
+		t.Errorf("a start fault is said: %q", errs.String())
+	}
+}
