@@ -0,0 +1,18 @@
+// The prompt a hand of its own takes opens on the line the spawn answer reads.
+// [[spec/design_output/pull#a-hand-of-its-own]]
+package pull // level0: InPackageTest - reaches the unexported spawnPrompt
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+func TestASpawnPromptOpensOnTheHandLineTheSpawnAnswerReads(t *testing.T) {
+	t.Parallel()
+	got := spawnPrompt("a-ticket", &Leaf{Entry: Entry{Path: "do"}}, "h1")
+	if !strings.HasPrefix(got, q.HandOfItsOwn+", named h1") {
+		t.Fatalf("the prompt opens on %q, and wants the line %q", strings.SplitN(got, "\n", 2)[0], q.HandOfItsOwn)
+	}
+}
