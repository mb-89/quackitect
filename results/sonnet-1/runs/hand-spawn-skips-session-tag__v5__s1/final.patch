+// The hand line stands open at its end, so the pull continues it with the hand's name.
+// [[spec/design_output/pull#a-hand-of-its-own]]
+package q_test
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+func TestTheHandLineEndsOnNoPunctuation(t *testing.T) {
+	t.Parallel()
+	if q.HandOfItsOwn == "" || strings.ContainsAny(q.HandOfItsOwn[len(q.HandOfItsOwn)-1:], ".,:;!?") {
+		t.Fatalf("the hand line %q is empty or ends on punctuation", q.HandOfItsOwn)
+	}
+}
