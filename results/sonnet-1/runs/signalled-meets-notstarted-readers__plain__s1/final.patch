 	}
 }
+
+func TestTheShellReadsALineASignalEndsAsItsExitWithNoFault(t *testing.T) {
+	t.Parallel()
+	sh := &proc.FakeRunner{Programs: map[string]proc.Program{"sh": func(proc.Command) proc.Said {
+		return proc.Said{Out: "part\n", Code: proc.Signalled}
+	}}}
+	out, exit, err := ShellOver(sh.Run, "the/root")("kill -TERM $$")
+	if out != "part\n" || exit != proc.Signalled || err != nil {
+		t.Errorf("the shell answers %q, %d, %v, and wants the signalled exit with no fault", out, exit, err)
+	}
+}
