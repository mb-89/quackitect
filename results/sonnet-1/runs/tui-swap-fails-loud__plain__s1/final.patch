+// [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiFailedSwapFailsLoudAndPrintsNoRows(t *testing.T) {
+	box := tuiBoxAt(t)
+	files := map[string]string{".se/.runtime/bin/logview/held": "running"}
+	for n := range tuiAside {
+		name := ".se/.runtime/bin/logview.old"
+		if n > 0 {
+			name += strconv.Itoa(n)
+		}
+		files[name+"/held"] = "held"
+	}
+	tuiWrites(t, box.root, files)
+	if exe, why, err := tuiViewerOf(box.doors()); exe != "" || why != "" || err == nil {
+		t.Fatalf("exe %q, why %q, err %v", exe, why, err)
+	}
+	tuiWrites(t, box.root, map[string]string{".se/.log/session.jsonl": tuiRowText})
+	code, out, errs := box.runs()
+	if code != exitFailed || out != "" || errs == "" {
+		t.Errorf("code %d, out %q, errs %q", code, out, errs)
+	}
