+// Every aside name holds a folder full of files, so the old binary finds no place to step aside. [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiSwapThatFailsAnswersTheErrorAndTheVerbPrintsThePlainRows(t *testing.T) {
+	box := tuiBoxAt(t)
+	files := map[string]string{".se/.runtime/bin/logview": "running binary"}
+	for n := range tuiAside {
+		name := ".se/.runtime/bin/logview.old"
+		if n > 0 {
+			name += fmt.Sprint(n)
+		}
+		files[name+"/held"] = "older binary"
+	}
+	tuiWrites(t, box.root, files)
+	if exe, why, err := tuiViewerOf(box.doors()); exe != "" || why != "" || err == nil {
+		t.Fatalf("exe %q, why %q, err %v", exe, why, err)
+	}
+	if _, err := os.Stat(box.root + "/.se/.runtime/bin/.logview-source"); err == nil {
+		t.Error("a failed swap stamps its source")
+	}
+	tuiWrites(t, box.root, map[string]string{".se/.log/session.jsonl": tuiRowText})
+	code, out, errs := box.runs()
+	if code != 0 || errs == "" || !strings.Contains(out, tuiNeedsGo) || len(box.launched) != 0 {
+		t.Errorf("code %d, out %q, errs %q, launched %v", code, out, errs, box.launched)
+	}
+}
