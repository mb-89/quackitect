+// A verb through quack's own road. A quiet run holds the verb's output, and a red one sends it to the error stream, so the part says why it failed. [[spec/tickets/the-verbs-need-no-wrapper]]
+func verbOver(run func(argv, env []string, quiet bool) (int, string, error), road, env []string, errs io.Writer) func(words []string, quiet bool) int {
+	return func(words []string, quiet bool) int {
+		code, said, err := run(append(slices.Clone(road), words...), env, quiet)
+		if err != nil {
+			fmt.Fprintln(errs, err)
+			return exitFailed
+		}
+		if quiet && code != 0 {
+			if said = strings.TrimSpace(said); said != "" {
+				fmt.Fprintln(errs, said)
+			}
+		}
+		return code
+	}
+}
