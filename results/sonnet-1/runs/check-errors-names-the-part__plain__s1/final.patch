+++ b/src/quack/verbover_test.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestVerbOver(t *testing.T) {
+	var got []string
+	run := func(code int, said string, err error) func(argv, env []string, quiet bool) (int, string, error) {
+		return func(argv, env []string, quiet bool) (int, string, error) {
+			got = argv
+			return code, said, err
+		}
+	}
+	t.Run("a quiet red verb says why on the error stream", func(t *testing.T) {
+		var errs strings.Builder
+		code := verbOver(run(1, "doors: bad\n", nil), []string{"q", "verb"}, nil, &errs)([]string{"doors"}, true)
+		if code != 1 || errs.String() != "doors: bad\n" || !reflect.DeepEqual(got, []string{"q", "verb", "doors"}) {
+			t.Fatalf("code %d, errs %q, argv %v", code, errs.String(), got)
+		}
+	})
+	t.Run("a quiet green verb says nothing", func(t *testing.T) {
+		var errs strings.Builder
+		if code := verbOver(run(0, "fine", nil), nil, nil, &errs)([]string{"x"}, true); code != 0 || errs.Len() != 0 {
+			t.Fatalf("code %d, errs %q", code, errs.String())
+		}
+	})
+	t.Run("a verb that cannot start names the fault", func(t *testing.T) {
+		var errs strings.Builder
+		if code := verbOver(run(0, "", errors.New("gone")), nil, nil, &errs)([]string{"x"}, false); code != exitFailed || errs.String() != "gone\n" {
+			t.Fatalf("code %d, errs %q", code, errs.String())
+		}
+	})
+}
