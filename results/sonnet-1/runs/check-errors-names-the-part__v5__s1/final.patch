+	t.Run("the check stands over the root QUACKITECT_ROOT names", func(t *testing.T) {
+		root := t.TempDir()
+		t.Setenv("QUACKITECT_ROOT", root)
+		if got := checkDoorsOf(io.Discard, io.Discard).root; filepath.Clean(got) != filepath.Clean(root) {
+			t.Fatalf("the check stands over %q, and wants %q", got, root)
+		}
+	})
+}
+
+func TestVerbOver(t *testing.T) {
+	ran := func(code int, said string, quiet bool) (int, string, [][]string) {
+		var argvs [][]string
+		run := func(argv, _ []string, _ bool) (int, string, error) {
+			argvs = append(argvs, argv)
+			return code, said, nil
+		}
+		var errs strings.Builder
+		got := verbOver(run, []string{"quack", "verb"}, nil, &errs)([]string{"doors"}, quiet)
+		return got, errs.String(), argvs
+	}
+	t.Run("a quiet red part hands its output to errs", func(t *testing.T) {
+		code, errs, argvs := ran(1, "src/a.js: broken\n", true)
+		if code != 1 || strings.TrimSpace(errs) != "src/a.js: broken" || !reflect.DeepEqual(argvs, [][]string{{"quack", "verb", "doors"}}) {
+			t.Fatalf("the part answers %d, %q, %v", code, errs, argvs)
+		}
+	})
+	t.Run("a quiet green part says nothing", func(t *testing.T) {
+		if code, errs, _ := ran(0, "fine", true); code != 0 || errs != "" {
+			t.Fatalf("the part answers %d, %q", code, errs)
+		}
+	})
+	t.Run("a loud red part leaves its output to the screen", func(t *testing.T) {
+		if code, errs, _ := ran(1, "shown", false); code != 1 || errs != "" {
+			t.Fatalf("the part answers %d, %q", code, errs)
+		}
+	})
+	t.Run("a run that cannot start names its fault", func(t *testing.T) {
+		var errs strings.Builder
+		run := func(argv, _ []string, _ bool) (int, string, error) { return 0, "", errors.New("not found") }
+		if code := verbOver(run, nil, nil, &errs)([]string{"doors"}, true); code != exitFailed || !strings.Contains(errs.String(), "not found") {
+			t.Fatalf("the part answers %d, %q", code, errs.String())
+		}
+	})
+	t.Run("under --errors the check sends part lines to stdout", func(t *testing.T) {
+		fake := &checkFake{}
+		doors := fake.doors()
+		doors.root = t.TempDir()
+		var out, errs strings.Builder
+		doors.errs = &errs
+		doors.verb = func(words []string, _ bool) int { return 0 }
+		doors.run = func(argv, _ []string, _ bool) (int, string, error) {
+			if argv[0] == "go" {
+				return 1, "--- FAIL: TestX (0.00s)\n", nil
+			}
+			return 0, "", nil
+		}
+		checkVerb(func(o, e io.Writer) checkDoors {
+			doors.out, doors.errs = o, e
+			return doors
+		})([]string{"check", "--errors"}, false, &out, &errs)
+		if !strings.Contains(out.String(), "--- FAIL: TestX") || errs.String() != "" {
+			t.Fatalf("stdout %q, stderr %q", out.String(), errs.String())
+		}
+	})
+}
