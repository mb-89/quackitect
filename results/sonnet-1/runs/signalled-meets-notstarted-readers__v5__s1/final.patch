 // What either runner answers a command naming no program. [[spec/design_output/doors#the-process-door]]
@@ -58,6 +59,19 @@ type Said struct {
 	Code int
 }
 
+// The fault of a run that never started or that a signal ended, and nil for any other run. [[spec/tickets/signalled-meets-notstarted-readers]]
+func (one Said) Fault() error {
+	switch {
+	case one.Code == NotStarted:
+		return errors.New(one.Err)
+	case one.Code == Signalled && one.Err == "":
+		return errors.New(endedOnSignal)
+	case one.Code == Signalled:
+		return errors.New(one.Err)
+	}
+	return nil
+}
+
 // The door: one run of one command. [[spec/design_output/doors#the-process-door]]
 type Runner func(Command) Said
 
