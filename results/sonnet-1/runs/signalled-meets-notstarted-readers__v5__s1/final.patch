--- /dev/null
+++ b/src/proc/proc_test.go
@@ -0,0 +1,27 @@
+package proc
+
+import "testing"
+
+func TestASaidRunCarriesAFaultOnlyWhereItNeverStartedOrASignalEndedIt(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		name  string
+		said  Said
+		fault string
+	}{
+		{"a run that never starts", Said{Err: "no program", Code: NotStarted}, "no program"},
+		{"a run a signal ends", Said{Err: "killed", Code: Signalled}, "killed"},
+		{"a run a signal ends with no stderr", Said{Code: Signalled}, endedOnSignal},
+		{"a nonzero exit", Said{Err: "warned", Code: 3}, ""},
+		{"a clean run", Said{Out: "said"}, ""},
+	}
+	for _, one := range cases {
+		fault := one.said.Fault()
+		switch {
+		case one.fault == "" && fault != nil:
+			t.Errorf("%s carries the fault %v, and wants none", one.name, fault)
+		case one.fault != "" && (fault == nil || fault.Error() != one.fault):
+			t.Errorf("%s carries %v, and wants the fault %q", one.name, fault, one.fault)
+		}
+	}
+}
