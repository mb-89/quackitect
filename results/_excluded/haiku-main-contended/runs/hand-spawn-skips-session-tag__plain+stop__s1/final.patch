diff --git a/src/pull/pull_branch_test.go b/src/pull/pull_branch_test.go
new file mode 100644
index 0000000..26180a1
--- /dev/null
+++ b/src/pull/pull_branch_test.go
@@ -0,0 +1,20 @@
+// The prompt a hand of its own takes, read as the spawn answer reads it: it
+// opens on the hand line the q package names. [[spec/design_output/pull#a-hand-of-its-own]]
+package pull
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+// A prompt a hand of its own takes opens on q.HandOfItsOwn, and names the hand it stands as. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestASpawnPromptOpensOnTheHandLine(t *testing.T) {
+	t.Parallel()
+	leaf := &Leaf{Entry: Entry{Path: "work/one"}}
+	got := spawnPrompt("ticket-one", leaf, "h1")
+	if !strings.HasPrefix(got, q.HandOfItsOwn+", named h1,") {
+		t.Fatalf("the prompt opens on %q, and wants the hand line %q", got, q.HandOfItsOwn)
+	}
+}
