@@ -0,0 +1,12 @@
+// The hand line a hand of its own opens its prompt on. [[spec/design_output/pull#a-hand-of-its-own]]
+package q
+
+import "testing"
+
+// The hand line names the box, and a spawn answer reads it as the hand of its own. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestTheHandLineNamesABoxHand(t *testing.T) {
+	const want = "You are a hand of your own on this box"
+	if HandOfItsOwn != want {
+		t.Fatalf("the hand line reads %q, and wants %q", HandOfItsOwn, want)
+	}
+}
