+package q
+
+// The opening a hand of its own reads as its prompt's first words. The pull writes it, and the door reads it to leave the hand untagged. [[spec/design_output/pull#a-hand-of-its-own]]
+const HandOfItsOwn = "You are a hand of your own on this box"
diff --git a/src/q/hand_test.go b/src/q/hand_test.go
new file mode 100644
index 0000000..0e687a9
--- /dev/null
+++ b/src/q/hand_test.go
@@ -0,0 +1,10 @@
+package q
+
+import "testing"
+
+// The hand's line is a sentence of its own, so the pull and the door read the same words. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestTheHandOfItsOwnIsAOpeningLine(t *testing.T) {
+	if HandOfItsOwn == "" || HandOfItsOwn[len(HandOfItsOwn)-1] == '.' {
+		t.Fatalf("the hand's line reads %q, and wants an opening with no closing stop", HandOfItsOwn)
+	}
+}
