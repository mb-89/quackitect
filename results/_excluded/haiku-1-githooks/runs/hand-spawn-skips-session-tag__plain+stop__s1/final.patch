--- /dev/null
+++ b/src/pull/pull_branch_test.go
@@ -0,0 +1,16 @@
+package pull
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+// The hand's prompt opens on the line the door reads as its own, and names the hand it spawns. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestASpawnPromptOpensOnTheHandOfItsOwn(t *testing.T) {
+	got := spawnPrompt("ticket-one", &Leaf{}, "helper-1")
+	if !strings.HasPrefix(got, q.HandOfItsOwn+", named helper-1,") {
+		t.Fatalf("the spawn prompt opens %q, and wants the hand's line naming helper-1", got)
+	}
+}
