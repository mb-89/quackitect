+// A hand's spawn opening on its own line takes no tag, though the session file names an id and the spawn carries no own field. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestASpawnOfAHandOfItsOwnTakesNoTag(t *testing.T) {
+	root := treeOf(t, map[string]string{sessionFile: `{"id":"s7"}`}, "")
+	door := holdDoor(t, Settings{Words: nameWords, Binding: queueBinding, BindingLayer: builtInLayer})
+	said, err := door.Hook(Post{Event: spawnEvent, Root: root, E: map[string]any{
+		"session_id": "s1", "prompt": q.HandOfItsOwn + ", named x-1, and you work one step of one ticket.",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, effect := range said.Effects {
+		if event, ok := effect.Result.(map[string]any); ok && effect.Kind == eventEffect {
+			t.Fatalf("a hand's spawn answers %+v, and wants no tag", event)
+		}
+	}
+}
