+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+// The hand line names its hand where the name goes, last in the opening. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestHandOfItsOwnLeavesTheNameToFollow(t *testing.T) {
+	if !strings.HasSuffix(q.HandOfItsOwn, "named ") {
+		t.Fatalf("the hand line %q stops short of the name", q.HandOfItsOwn)
+	}
+}
