diff --git a/src/pull/pull_branch_test.go b/src/pull/pull_branch_test.go
new file mode 100644
index 0000000..280405a
--- /dev/null
+++ b/src/pull/pull_branch_test.go
@@ -0,0 +1,17 @@
+package pull // level0: InPackageTest - the case calls the unexported spawnPrompt the hand line leads
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+// A hand of its own reads the hand line first, so the spawn hook knows it takes no session tag. [[spec/design_output/pull#a-hand-of-its-own]]
+func TestASpawnPromptOpensOnTheHandOfItsOwn(t *testing.T) {
+	t.Parallel()
+	prompt := spawnPrompt("alpha", &Leaf{}, "helper-1")
+	if !strings.HasPrefix(prompt, q.HandOfItsOwn) {
+		t.Fatalf("the spawn prompt opens %q, and wants the hand line %q", prompt, q.HandOfItsOwn)
+	}
+}
