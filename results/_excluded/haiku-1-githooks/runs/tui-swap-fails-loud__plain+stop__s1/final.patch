+	if code != exitFailed || out != "" || errs != err.Error()+"\n" {
+		t.Errorf("code %d, out %q, errs %q", code, out, errs)
+	}
+	if strings.Contains(errs, "Install Go") || len(box.launched) != 0 {
+		t.Errorf("errs %q, launched %v", errs, box.launched)
