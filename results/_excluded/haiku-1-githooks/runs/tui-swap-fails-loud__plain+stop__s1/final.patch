+// A fresh build that cannot take the binary's name fails loud: no viewer, no plain rows, and no ask for Go on a box that holds it. [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiSwapFailureFailsLoud(t *testing.T) {
+	box := tuiBoxAt(t)
+	tuiWrites(t, box.root, map[string]string{".se/.log/session.jsonl": tuiRowText})
+	// Every name an old binary tries is a folder full of files, so the rename of the running binary refuses.
+	tuiWrites(t, box.root, map[string]string{".se/.runtime/bin/logview": "old binary"})
+	for n := range tuiAside {
