+// A fresh build that cannot swap in fails loud: the verb names the fault and prints no rows, where a box holding Go would otherwise ask for it. [[spec/design_output/tui#the-verb-builds-it]]
+func TestTuiSwapFailureFailsLoud(t *testing.T) {
+	box := tuiBoxAt(t)
+	files := map[string]string{".se/.log/session.jsonl": tuiRowText}
+	files[".se/.runtime/bin/logview"] = "old binary"
+	// Every name an old binary tries is a folder that cannot be removed, so the rename of the old binary fails.
+	for n := range tuiAside {
+		name := ".se/.runtime/bin/logview.old"
+		if n > 0 {
+			name = fmt.Sprintf("%s%d", name, n)
+		}
+		files[name+"/held"] = "held"
+	}
+	tuiWrites(t, box.root, files)
+	exe, why, err := tuiViewerOf(box.doors())
+	if err == nil || exe != "" || why != "" {
+		t.Fatalf("exe %q, why %q, err %v", exe, why, err)
+	}
+	if _, statErr := os.Stat(box.root + "/.se/.runtime/bin/.logview-source"); statErr == nil {
+		t.Error("a failed swap stamps its source")
+	}
+	code, out, errs := box.runs()
+	if code != exitFailed || out != "" || errs != err.Error()+"\n" {
+		t.Errorf("code %d, out %q, errs %q", code, out, errs)
+	}
+}
