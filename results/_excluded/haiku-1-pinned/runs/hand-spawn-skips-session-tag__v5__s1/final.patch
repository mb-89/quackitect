+// The hand line names a hand of its own, and holds the name the pull fills in.
+// [[spec/tickets/hand-spawn-skips-session-tag]]
+package q_test
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+// The hand line opens on a hand of its own, and ends where the name starts. [[spec/tickets/hand-spawn-skips-session-tag]]
+func TestTheHandLineOpensOnAHandOfItsOwn(t *testing.T) {
+	if !strings.HasPrefix(q.HandOfItsOwn, "You are a hand of your own") || !strings.HasSuffix(q.HandOfItsOwn, "named ") {
+		t.Fatalf("the hand line reads %q", q.HandOfItsOwn)
+	}
+}
