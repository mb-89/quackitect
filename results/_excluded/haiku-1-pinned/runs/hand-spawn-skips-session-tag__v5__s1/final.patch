+// The prompt a hand of its own takes opens on the hand line the spawn door reads.
+// [[spec/tickets/hand-spawn-skips-session-tag]]
+package pull // level0: InPackageTest - reaches the unexported spawnPrompt
+
+import (
+	"strings"
+	"testing"
+
+	"quackitect/src/q"
+)
+
+// The prompt a hand of its own takes opens on the hand line of q.HandOfItsOwn, then the hand's name. [[spec/tickets/hand-spawn-skips-session-tag]]
+func TestASpawnPromptOpensOnTheHandLineOfItsOwn(t *testing.T) {
+	t.Parallel()
+	prompt := spawnPrompt("the-ticket", &Leaf{}, "helper-1")
+	if !strings.HasPrefix(prompt, q.HandOfItsOwn+"helper-1") {
+		t.Fatalf("the prompt opens %q, and wants the hand line of its own", prompt)
+	}
+}
