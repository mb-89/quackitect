# machine-local — never committed. The folder itself is NOT ignored, because
# git honours a negation only inside a directory it can still see.
.se/*
!.se/quack-watch.json
*.log

# node
node_modules/

# editors / OS
.vscode/
.obsidian/workspace.json
Thumbs.db
.DS_Store

# worktrees (later milestone)
.worktrees/

# the scratchpad is the agent's workbench — whatever it wants, never committed
# (owner ruling 2026-08-12). The no-binaries rule stops reaching into it, which
# is what req-every-artifact-is-readable-text was always about: the PRODUCT.
scratchpad/

# built packages — assembled by engine/bin/package.ts, never committed
dist/

# the rendered VS Code extension — produced by esbuild.mjs, carries the real
# product name where the source keeps placeholders, never committed
deliverable/vscode-dist/


# THE CAGE AND THE LANE ARE COMMITTED, and .mcp.json is the reason.
#
# A cloud clone is all a cloud session gets. The editor client builds its MCP
# server list from .mcp.json when the session STARTS, before any hook has run,
# so a file a hook writes arrives too late to be read.
#
# .claude/settings.json was tracked already and .mcp.json was not, which is
# exactly "the cage lands and the lane does not": every native tool denied,
# and no se_ tool to replace them. Both are tracked now.
#
# The root .mcp.json is the STDIO form. It spawns the lane itself, so there is
# no port to be listening and no race to lose.
.copilot/
.github/copilot-instructions.md
