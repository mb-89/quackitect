.bin/
.se/
_to_delete/
node_modules/
*.jsonl
# EXCEPT THE ARCHIVE, WHICH IS THE ONE JSONL THAT HAS TO TRAVEL. A closed
# tracked token comes off the disk and this list is what names the git objects
# holding it. Ignored, it stayed on one machine, so the archive stayed on one
# machine with it and every other box read a tree where the work had never been.
!doc/work/archive.jsonl

# built programs belong in .bin/, never next to their source
src/engine/engine
src/engine/engine.exe
src/viewer/viewer
src/viewer/viewer.exe
src/mcp/mcp
src/mcp/mcp.exe
util/setup/setup
util/setup/setup.exe
src/extension/out/
*.tgz
*.tar.gz
dev_guide/*
# design notes and plans, owner-kept and not the product
dev_guide/

# the guard's HTTP door is this machine's own, and its port is derived from
# this folder's path. See util/cage/claude-settings.json.
.claude/settings.local.json
