# Runtime state. It is private to one box and never travels.
.se/

# The local cage does not exist in this tree. Level zero is enabled by the
# tracked settings file, which carries no port and no machine-specific path.
.claude/settings.local.json

# /plugin-types writes the plugin API of the running build here. A new build
# writes it again, so each box keeps its own.
.claude/types/

# A helper's worktree stands here for one task, and git holds a worktree as a
# folder of its own.
.claude/worktrees/

# Setup generates the Copilot registrations under .github, and this tree tracks
# them on purpose. A cloud box reads its hooks and its setup job from the
# default branch, so committing them is what keeps level zero active there.

node_modules/
src/tui/tui
src/tui/tui.exe
src/index/index
src/index/index.exe
src/lsp/lsp
src/lsp/lsp.exe
src/yaml/yaml
src/yaml/yaml.exe

# The install script writes this from spec/config/brand/icon.svg, which the
# vehicle owns. [[spec/design_output/vehicle#the-brand-a-vehicle-stamps]]
src/extension/icon.svg

# The install script stamps the brand into both manifests on every box, so
# nobody authors them and git holds neither. [[spec/design_output/vehicle#the-brand-a-vehicle-stamps]]
.claude-plugin/marketplace.json
.claude/skills/level0/.claude-plugin/plugin.json
