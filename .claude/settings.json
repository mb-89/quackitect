{
  "permissions": {
    "deny": [
      "Bash",
      "BashOutput",
      "KillShell",
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "Skill"
    ],
    "allow": [
      "mcp__se__*"
    ]
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "MAX_THINKING_TOKENS": "31999"
  },
  "alwaysThinkingEnabled": true,
  "outputStyle": "voice",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"deliverable/engine/bin/se-hook-stop.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"deliverable/engine/bin/se-hook-websearch.ts\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"deliverable/engine/bin/se-hook-arrive.ts\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"deliverable/engine/bin/se-hook-start.ts\""
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"deliverable/engine/bin/se-hook-start.ts\" --compacted"
          }
        ]
      }
    ]
  }
}
