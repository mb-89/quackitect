{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node project/deliverable/engine/bin/se-hook-arrive.ts",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node project/deliverable/engine/bin/se-hook-stop.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
