{
  "$comment": "GENERATED by .bin/se-mcp --tools \u003e util/cage/tools.json. Edit src/mcp/lane.go, not this file.",
  "tools": [
    {
      "description": "TEST WHAT YOU CHANGED, naming the token: on: \u003cid\u003e.",
      "inputSchema": {
        "properties": {
          "on": {
            "type": "string"
          },
          "plan": {
            "description": "say what would run, run nothing",
            "type": "boolean"
          },
          "propose": {
            "description": "tests by name, or patterns",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "name": "se_test"
    },
    {
      "description": "TAKE A BLOCK OF WORK so no other box starts it: next: \u003cn\u003e, or these: [ids]. It publishes to git by itself, and list says what is claimed.",
      "inputSchema": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "as": {
            "description": "with next: worker or reviewer",
            "type": "string"
          },
          "list": {
            "type": "boolean"
          },
          "next": {
            "description": "claim what the queue would hand you on this many pulls",
            "type": "integer"
          },
          "release": {
            "description": "give back what you hold",
            "type": "boolean"
          },
          "these": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "whoami": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "se_claim"
    },
    {
      "description": "SEARCH THE TREE THROUGH THE INDEX: words (FTS5), regex, or path (a glob; alone it lists files).",
      "inputSchema": {
        "properties": {
          "limit": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "regex": {
            "type": "string"
          },
          "words": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "se_find"
    },
    {
      "description": "ASK THE INDEX: sql, read-only; schema prints the tables.",
      "inputSchema": {
        "properties": {
          "dangling": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer"
          },
          "links": {
            "type": "string"
          },
          "schema": {
            "type": "boolean"
          },
          "search": {
            "type": "string"
          },
          "sql": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "se_ask"
    },
    {
      "description": "CHANGE FILES, naming the token: on: \u003cid\u003e. op: left off (replace old, exactly once, with new), create, write. undo puts back what that token wrote, and never another agent's work.",
      "inputSchema": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "dry": {
            "type": "boolean"
          },
          "edits": {
            "items": {
              "properties": {
                "file": {
                  "type": "string"
                },
                "new": {
                  "type": "string"
                },
                "old": {
                  "type": "string"
                },
                "op": {
                  "type": "string"
                }
              },
              "required": [
                "file"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "on": {
            "type": "string"
          },
          "undo": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "se_apply"
    },
    {
      "description": "RUN A SHELL COMMAND in the work folder, naming the token: on: \u003cid\u003e. A long output pages with page and from.",
      "inputSchema": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "from": {
            "type": "integer"
          },
          "on": {
            "type": "string"
          },
          "page": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "se_run"
    },
    {
      "description": "MINT A WORK TOKEN: title (four words at most), detail, done_when, and tracked, which says where it is born. tracked true puts it in doc/work, which git carries, so another agent on another box can claim it. tracked false keeps it in .se/work, for small work you do yourself next. A note takes neither and is always private. Or on: \u003cid\u003e takes that token into your hands.",
      "inputSchema": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "detail": {
            "type": "string"
          },
          "done_when": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "on": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "process": {
            "type": "string"
          },
          "proposed_action": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tracked": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "name": "se_work"
    },
    {
      "description": "NAME WHY YOU ARE STOPPING, when a stop was refused. No arguments reads the list.",
      "inputSchema": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "because": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "se_stop"
    },
    {
      "description": "PULL FOR WORK; act on work, refused or wait. Submit with id and disposition, the checklist answered on the note.",
      "inputSchema": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "evidence": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "role": {
            "description": "worker, or reviewer for verdicts owed",
            "type": "string"
          },
          "successors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "name": "se_pull"
    },
    {
      "description": "What the engine knows: the two roots, the log it is writing, and the rules in force.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "se_status"
    },
    {
      "description": "ANSWER THE PERSON, IN THE RECORD: the whole answer, for every prompt. Then keep working.",
      "inputSchema": {
        "properties": {
          "answer": {
            "description": "what you would have said to them. The whole answer, not a summary of it.",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "type": "object"
      },
      "name": "se_answer"
    },
    {
      "description": "PUT WHAT THE PERSON SAID IN THE RECORD, WORD FOR WORD, when the engine has not already copied it. Copy their sentence. Do not shorten it, tidy it or join two of them.",
      "inputSchema": {
        "properties": {
          "said": {
            "description": "what they said, copied. Their words and nothing else.",
            "type": "string"
          }
        },
        "required": [
          "said"
        ],
        "type": "object"
      },
      "name": "se_said"
    }
  ]
}
