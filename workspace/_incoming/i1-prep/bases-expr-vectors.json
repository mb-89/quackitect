{
  "_readme": [
    "EXECUTABLE SPEC for i1 proof 2 — the Bases expression language.",
    "Derived 2026-08-02 from product/spec/bases-syntax.md (sections 1, 7, 8, 9).",
    "Shape: every vector is an EXPRESSION EXPECTED TRUE when evaluated against",
    "the named fixture note (default 'book'), so the runner is trivial:",
    "eval(expr, note) === true, or the named error class for expect:'error:*'.",
    "Equality-to-literal inside the expression dodges representation questions.",
    "These become the red tests of the spike (M7_10/M7_30 shape): all fail while",
    "the language does not exist; the parser+evaluator turns them green.",
    "The lambda vectors (filter/map/reduce) matter most: expressions with BOUND",
    "NAMES, not closures — a parser requirement, per the reference."
  ],
  "fixtures": {
    "book": {
      "path": "Required Reading/Moby Dick.md",
      "frontmatter": {
        "price": 10.5, "age": 3, "status": "reading", "done": false,
        "rating": 4, "tags_fm": ["book", "classic"],
        "authors": ["[[Melville]]"], "published": "1851-10-18",
        "empty_str": "", "items": [3, 1, 2, 1]
      },
      "file": {
        "name": "Moby Dick", "ext": "md", "folder": "Required Reading",
        "path": "Required Reading/Moby Dick.md", "size": 1234,
        "tags": ["#book", "#book/classic"],
        "links": ["[[Melville]]", "[[Textbook]]"]
      }
    },
    "melville": {
      "path": "People/Melville.md",
      "frontmatter": {},
      "file": { "name": "Melville", "ext": "md", "folder": "People", "path": "People/Melville.md", "size": 10, "tags": [], "links": [] }
    }
  },
  "vectors": {
    "arithmetic": [
      { "expr": "1 + 2 * 3 == 7" },
      { "expr": "(1 + 2) * 3 == 9" },
      { "expr": "7 % 3 == 1" },
      { "expr": "price / age == 3.5" },
      { "expr": "(price / age).toFixed(2) == \"3.50\"" },
      { "expr": "-price == 0 - 10.5" }
    ],
    "comparison": [
      { "expr": "price > 2.1" },
      { "expr": "price >= 10.5" },
      { "expr": "age < 4" },
      { "expr": "status != \"done\"" },
      { "expr": "status == \"reading\"" },
      { "expr": "rating <= 4" },
      { "expr": "(1 == \"1\") == false", "note_": "equality works on any value but types differ" }
    ],
    "boolean": [
      { "expr": "!done" },
      { "expr": "price > 5 && age < 10" },
      { "expr": "price > 100 || rating == 4" },
      { "expr": "!(price > 100)" }
    ],
    "types-and-literals": [
      { "expr": "[1, 2, 3][0] == 1" },
      { "expr": "items[2] == 2" },
      { "expr": "{\"name\": \"value\"}[\"name\"] == \"value\"" },
      { "expr": "{\"name\": \"value\"}.name == \"value\"" },
      { "expr": "(2.5) == 2.5" },
      { "expr": "true != false" },
      { "expr": "'single' == \"single\"" }
    ],
    "namespaces": [
      { "expr": "note.price == price" },
      { "expr": "note[\"price\"] == price" },
      { "expr": "file.ext == \"md\"" },
      { "expr": "file.name == \"Moby Dick\"" },
      { "expr": "file.folder == \"Required Reading\"" }
    ],
    "global-functions": [
      { "expr": "if(price, \"yes\", \"no\") == \"yes\"" },
      { "expr": "if(empty_str, \"yes\", \"no\") == \"no\"" },
      { "expr": "if(missing_prop, \"yes\") == null", "note_": "falseResult defaults to null" },
      { "expr": "max(1, 9, 4) == 9" },
      { "expr": "min(1, 9, 4) == 1" },
      { "expr": "number(true) == 1" },
      { "expr": "number(false) == 0" },
      { "expr": "number(\"42\") == 42" },
      { "expr": "list(1).length == 1", "note_": "non-list wrapped in one-element list" },
      { "expr": "list([1,2]).length == 2", "note_": "a list passes unchanged" },
      { "expr": "escapeHTML(\"<b>\") == \"&lt;b&gt;\"" }
    ],
    "string-functions": [
      { "expr": "\"Moby\".length == 4" },
      { "expr": "status.contains(\"read\")" },
      { "expr": "status.containsAll(\"r\", \"g\")" },
      { "expr": "status.containsAny(\"zzz\", \"read\")" },
      { "expr": "status.startsWith(\"read\")" },
      { "expr": "status.endsWith(\"ing\")" },
      { "expr": "empty_str.isEmpty()" },
      { "expr": "missing_prop.isEmpty()", "note_": "true when empty OR absent" },
      { "expr": "\"AbC\".lower() == \"abc\"" },
      { "expr": "\"war and peace\".title() == \"War And Peace\"" },
      { "expr": "\"ab\".repeat(3) == \"ababab\"" },
      { "expr": "\"abc\".reverse() == \"cba\"" },
      { "expr": "\"abcdef\".slice(1, 3) == \"bc\"" },
      { "expr": "\"abcdef\".slice(4) == \"ef\"" },
      { "expr": "\"  x \".trim() == \"x\"" },
      { "expr": "\"a,b,c\".split(\",\").length == 3" },
      { "expr": "\"a,b,c\".split(\",\", 2).length == 2" },
      { "expr": "\"aaa\".replace(\"a\", \"b\") == \"bbb\"", "note_": "string pattern replaces EVERY occurrence" },
      { "expr": "\"a1b2\".replace(/[0-9]/, \"\") == \"a1b2\".replace(/[0-9]/g, \"\")", "expect": false, "note_": "a Regexp obeys its g flag: /x/ once, /x/g all — so these differ" }
    ],
    "number-functions": [
      { "expr": "(-3.2).abs() == 3.2" },
      { "expr": "(2.1).ceil() == 3" },
      { "expr": "(2.9).floor() == 2" },
      { "expr": "(2.446).round(2) == 2.45" },
      { "expr": "(2.5).round() == 3" },
      { "expr": "price.toFixed(2) == \"10.50\"", "note_": "toFixed returns a STRING" },
      { "expr": "missing_prop.isEmpty()" }
    ],
    "list-functions": [
      { "expr": "items.length == 4" },
      { "expr": "items.contains(3)" },
      { "expr": "items.containsAll(1, 2)" },
      { "expr": "items.containsAny(99, 2)" },
      { "expr": "items.unique().length == 3" },
      { "expr": "items.sort()[0] == 1" },
      { "expr": "items.reverse()[0] == 1" },
      { "expr": "[[1, 2], [3]].flat().length == 3" },
      { "expr": "[\"a\", \"b\"].join(\"-\") == \"a-b\"" },
      { "expr": "items.slice(0, 2).length == 2" },
      { "expr": "items.filter(value > 1).length == 2", "note_": "EXPRESSION with bound name `value`, not a lambda" },
      { "expr": "items.filter(index == 0)[0] == 3", "note_": "bound name `index`" },
      { "expr": "items.map(value * 2)[0] == 6" },
      { "expr": "items.reduce(acc + value, 0) == 7", "note_": "bound names value, index, acc" }
    ],
    "date-and-duration": [
      { "expr": "date(\"2026-01-31\") < date(\"2026-02-01\")" },
      { "expr": "published.year == 1851" },
      { "expr": "published.month == 10", "note_": "month is 1-12" },
      { "expr": "published.day == 18" },
      { "expr": "date(\"2026-01-15\") + \"1M\" == date(\"2026-02-15\")" },
      { "expr": "date(\"2026-01-15\") - \"2d\" == date(\"2026-01-13\")" },
      { "expr": "date(\"2026-01-02\") - date(\"2026-01-01\") == 86400000", "note_": "date minus date is MILLISECONDS" },
      { "expr": "duration(\"5h\") * 2 == duration(\"10h\")", "note_": "duration on the LEFT, always" },
      { "expr": "date(\"2026-03-03\").format(\"YYYY-MM-DD\") == \"2026-03-03\"" },
      { "expr": "published.date() == date(\"1851-10-18\")" },
      { "expr": "published.isEmpty() == false", "note_": "date isEmpty is always false" }
    ],
    "file-and-link-functions": [
      { "expr": "file.hasTag(\"book\")" },
      { "expr": "file.hasTag(\"book/classic\")" },
      { "expr": "file.hasTag(\"zzz\", \"book\")", "note_": "any-of" },
      { "expr": "file.hasTag(\"classic\") == false", "note_": "#book/classic is nested under #book, not #classic" },
      { "expr": "file.inFolder(\"Required Reading\")" },
      { "expr": "file.hasLink(\"Textbook\")" },
      { "expr": "file.hasProperty(\"price\")" },
      { "expr": "file.hasProperty(\"zzz\") == false" },
      { "expr": "authors.contains(link(\"Melville\"))", "note_": "Link equality: resolves to the same file" },
      { "expr": "link(\"Melville\").asFile().name == \"Melville\"", "fixture_context": "melville must exist in the model" }
    ],
    "composite-from-the-reference": [
      { "expr": "if(price, price.toFixed(2) + \" dollars\") == \"10.50 dollars\"", "note_": "formatted_price from section 1" },
      { "expr": "(price / age).toFixed(2) == \"3.50\"", "note_": "ppu from section 1" },
      { "expr": "status != \"done\" && ((price / age) > 5 || price > 2.1)", "note_": "the view filter from section 1, formula inlined" }
    ],
    "refusals": [
      { "expr": "number(\"abc\")", "expect": "error:unparseable-number" },
      { "expr": "unknownFn(1)", "expect": "error:unknown-function", "note_": "refuse BY NAME — the standing law" },
      { "expr": "price >", "expect": "error:parse" },
      { "expr": "\"a\" > \"b\"", "expect": "error:ordering-on-strings", "note_": "ordering works on numbers and dates; adjust if the owner rules JS coercion instead" }
    ],
    "formula-namespace": [
      { "base_formulas": { "ppu": "(price / age).toFixed(2)", "double_ppu": "formula.ppu + formula.ppu" }, "expr": "formula.ppu == \"3.50\"" },
      { "base_formulas": { "a": "formula.b", "b": "formula.a" }, "expr": "formula.a", "expect": "error:circular-formula" }
    ]
  }
}
