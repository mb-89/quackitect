{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "the sidebar",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/src/extension"]
    },
    {
      "name": "the server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/bridge/server.js",
      "args": ["${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
