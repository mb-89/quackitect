{
  "vale.valeCLI.installVale": false,
  "vale.valeCLI.path": ".se/run/bin/vale",
  "vale.valeCLI.config": ".vale.ini",
  "vale.valeCLI.minAlertLevel": "inherited",
  "vale.valeCLI.lintOnChange": true,
  "vale.enableSpellcheck": false,
  "biome.lsp.bin": {
    "linux-x64": ".se/run/bin/biome",
    "linux-arm64": ".se/run/bin/biome",
    "linux-x64-musl": ".se/run/bin/biome",
    "linux-arm64-musl": ".se/run/bin/biome",
    "darwin-x64": ".se/run/bin/biome",
    "darwin-arm64": ".se/run/bin/biome",
    "win32-x64": ".se/run/bin/biome.exe",
    "win32-arm64": ".se/run/bin/biome.exe"
  },
  "biome.configurationPath": "spec/config/biome.json",
  "json.schemas": [
    {
      "fileMatch": ["/spec/config/level0.json"],
      "url": "./spec/config/level0.schema.json"
    }
  ],
  "biome.requireConfiguration": true,
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
