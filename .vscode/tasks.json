{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "the rules over this tree",
      "detail": "Every rule this tree holds, over every file, into the Problems panel.",
      "type": "shell",
      "command": "./RUNME.sh",
      "args": ["lint"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": {
        "owner": "quackitect",
        "source": "quackitect",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (\\S+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    }
  ]
}
