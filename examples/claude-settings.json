{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "hx hook session-start"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "hx hook prompt"}]}],
    "PreToolUse": [{"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
                    "hooks": [{"type": "command", "command": "hx hook pre-tool"}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "hx hook post-tool"}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "hx hook pre-compact"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "hx hook stop"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "hx hook session-end"}]}]
  }
}
