{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["bin/**/*.ts", "engine/**/*.ts", "tests/**/*.ts"]
}
