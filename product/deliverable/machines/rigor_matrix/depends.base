# THE DEPENDENCY MATRIX, as a pivot of the notes themselves.
#
# Nothing new is stored here. Every cell comes from one rigor row's own
# `depends_on`, which is why the picture can never disagree with the data:
# there is only one copy of it, in the notes.
#
# OBSIDIAN CANNOT OPEN THIS FILE. `type: pivot` is ours, not Bases'. It is
# kept out of matrix.base for exactly that reason — that one stays readable
# by both, and this one is what replaces needing Obsidian at all.

properties:
  # `depends_on` NAMES THE `name` FIELD, never the filename. Crossing
  # file.name with depends_on gives a grid whose two axes are different
  # vocabularies: measured, zero of the 50 row labels appeared among the 49
  # column labels, so the matrix had no diagonal anywhere in it.
  name:
    displayName: Step
  depends_on:
    displayName: Waits for
  state_kind:
    displayName: Kind
  patch:
    displayName: Patch
  minor:
    displayName: Minor
  major:
    displayName: Major

views:
  # Fifty steps against the forty-eight things they wait for. Read down the
  # side for what a step waits on; read along the Σ row for how many steps
  # wait on each. The last column is a step's own fan-out.
  - type: pivot
    name: What each step waits for
    filters:
      and:
        - kind == "matrix-row"
    rows: name
    columns: depends_on
    aggregate: count

  # The tailoring, counted rather than listed: how many steps of each kind
  # survive a patch. `none` means the column strikes the step out.
  - type: pivot
    name: Kind against the patch column
    filters:
      and:
        - kind == "matrix-row"
    rows: state_kind
    columns: patch
    aggregate: count

  # The same crossing, naming the steps instead of counting them — the form
  # you want when a cell surprises you and you need to know which ones.
  - type: pivot
    name: Which steps, by kind and minor
    filters:
      and:
        - kind == "matrix-row"
    rows: state_kind
    columns: minor
    aggregate: list
    value: file.name
