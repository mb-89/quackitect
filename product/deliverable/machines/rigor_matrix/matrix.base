properties:
  file.name:
    displayName: State
  state_kind:
    displayName: Kind
  statement:
    displayName: Statement
  patch:
    displayName: Patch
  minor:
    displayName: Minor
  major:
    displayName: Major
  product:
    displayName: Product
  specification:
    displayName: Specification
  patch_note:
    displayName: Patch note
  minor_note:
    displayName: Minor note
  major_note:
    displayName: Major note
  product_note:
    displayName: Product note
  specification_note:
    displayName: Specification note
  comment:
    displayName: Comment
views:
  - type: table
    name: The matrix
    filters:
      and:
        - kind == "matrix-row"
    order:
      - file.name
      - state_kind
      - patch
      - minor
      - major
      - product
      - specification
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: The tailoring, in full
    filters:
      and:
        - kind == "matrix-row"
    order:
      - file.name
      - patch_note
      - minor_note
      - major_note
      - product_note
      - specification_note
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Struck at patch
    filters:
      and:
        - kind == "matrix-row"
        - patch == "none"
    order:
      - file.name
      - patch_note
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Struck at minor
    filters:
      and:
        - kind == "matrix-row"
        - minor == "none"
    order:
      - file.name
      - minor_note
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Open review comments
    filters:
      and:
        - kind == "matrix-row"
        - comment
    order:
      - file.name
      - comment
