# Architecturally significant requirements: the high-weight rows AND the quality rows.
filters:
  and:
    - 'type == "requirement"'
    - or:
        - 'weight >= 0.7'
        - 'kind == "quality"'
views:
  - type: table
    name: Architecturally significant requirements
    order: [name, statement, kind]
    sort:
      - property: weight
        direction: DESC
