# The pull law as a query: `referenced` is the emitter's link graph - only sources a
# chapter actually cites render in the book. Obsidian does not know the property, so the
# preview shows ALL references (the superset); the book stays the truth.
# The DESC sort on the groupBy property puts Normative before Informative (ISO clause-2
# style). Render full: title, pin, URL, and the annotation body per entry.
filters:
  and:
    - 'file.inFolder("spec/references")'
    - 'referenced != false'
views:
  - type: table
    name: References
    render: full
    order: [title, version, url]
    groupBy: kind
    sort:
      - property: kind
        direction: DESC
