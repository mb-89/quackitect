# Methods consolidate in the APPENDIX:
# no per-chapter "methods that apply here" views - a chapter
# mentions an applicable method in its PROSE as a link (the details pane shows the
# brief, the link lands here on the full method). The pull law filters to methods
# the chapters actually mention; Obsidian does not know the property, so the
# preview shows ALL methods (the superset).
# The appendix view is a TABLE like its siblings: one row per method
# (name plus brief), the full body one expand away.
filters:
  and:
    - 'file.inFolder("methods")'
    - 'referenced != false'
views:
  - type: table
    name: Methods in full
    order: [name, statement]
