properties:
  name:
    opensNote: true
columnSize:
  name: 44
  flags: 6
  queue: 6
flags:
  - key: state
    value: true
    tones:
      open: good
      draft: bad
  - key: route
    value: true
    tones:
      note: note
      trivial: trivial
      standard: standard
      group: group
      question: question
      retro: retro
  - letter: U
    key: urgent
    tone: bad
  - letter: C
    key: cloud
  - letter: T
    key: todo
    tone: bad
groups:
  - name: queue
    pressed: true
    filters:
      - queue: /./
    sort:
      - key: queue
  - name: in hand
    filters:
      - queue: /^0$/
  - name: recently done
    filters:
      - state: closed
    sort:
      - key: changed
        down: true
  - name: urgent
    filters:
      - urgent: true and not state: closed
  - name: todos
    filters:
      - todo: true
views:
  - type: table
    name: every ticket
    order:
      - name
      - flags
      - queue
    nest: group
    sort:
      - key: queue
    collapsed:
      - closed
