properties:
  name:
    opensNote: true
columnSize:
  name: 34
  flags: 5
  step: 14
  group: 26
  queue: 6
flags:
  - key: state
    value: true
  - letter: U
    key: urgent
  - letter: W
    key: held
  - letter: T
    key: todo
groups:
  - name: not done
    pressed: true
    filters:
      - not state: closed
  - name: queue
    filters:
      - queue: /./
    sort:
      - key: queue
  - name: held
    filters:
      - held: true
  - name: unsorted
    filters:
      - "state: draft or not group: /./"
views:
  - type: table
    name: every ticket
    order:
      - name
      - flags
      - step
      - group
      - queue
    nest: group
    sort:
      - key: urgent
        down: true
      - key: queue
    collapsed:
      - closed
