filters:
  - kind: ticket
properties:
  name:
    opensNote: true
columnSize:
  name: 34
  state: 8
  urgent: 7
  progress: 9
  queue: 6
groups:
  - name: not done
    pressed: true
    filters:
      - not state: closed
  - name: queue
    filters:
      - queue: /./
    sort:
      - key: queue
  - name: yours
    filters:
      - person: person
    sort:
      - key: stood
  - name: unsorted
    filters:
      - "state: draft or not group: /./"
    sort:
      - key: stood
views:
  - type: table
    name: every ticket
    order:
      - name
      - state
      - urgent
      - progress
      - queue
      - says
    nest: group
    sort:
      - key: person
      - key: queue
    collapsed:
      - closed
