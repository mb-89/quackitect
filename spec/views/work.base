properties:
  name:
    opensNote: true
columnSize:
  name: 44
  flags: 6
  queue: 6
flags:
  - key: state
    value: true
    tones:
      open: good
      draft: bad
  - letter: U
    key: urgent
    tone: bad
  - letter: W
    key: held
    tone: good
  - letter: C
    key: cloud
    tone: good
  - letter: T
    key: todo
    tone: bad
groups:
  - name: queue
    pressed: true
    filters:
      - queue: /./
    sort:
      - key: queue
  - name: held
    filters:
      - held: true
  - name: recently done
    filters:
      - state: closed
    sort:
      - key: changed
        down: true
  - name: urgent
    filters:
      - urgent: true and not state: closed
views:
  - type: table
    name: every ticket
    order:
      - name
      - flags
      - queue
    nest: group
    sort:
      - key: queue
    collapsed:
      - closed
