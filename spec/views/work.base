reads: work/rows
badge: work/open-tasks
actions:
  - key: p
    arg: digit
    calls: work/place
  - key: u
    calls: tickets/flip-urgent
  - key: enter
    edits: cell
    writes: tickets/set-field
  - button: pull
    calls: work/pull
properties:
  name:
    opensNote: true
columnSize:
  name: 44
  flags: 6
  queue: 6
flags:
  - key: state
    value: true
    tones:
      open: good
      held: held
      draft: bad
      closed: closed
  - key: route
    value: true
    tones:
      note: note
      trivial: trivial
      standard: standard
      group: group
      question: question
      retro: retro
  - letter: U
    key: urgent
    tone: bad
  - letter: C
    key: cloud
  - letter: T
    key: todo
    tone: bad
  - letter: P
    key: person
groups:
  - name: queue
    pressed: true
    filters:
      - queue: /./
    sort:
      - key: queue
  - name: in hand
    filters:
      - queue: /^0$/
  - name: recently done
    filters:
      - state: closed
    sort:
      - key: changed
        down: true
  - name: urgent
    filters:
      - urgent: true and not state: closed
  - name: todos
    filters:
      - todo: true
  - name: open
    filters:
      - not state: closed
  - name: notes
    filters:
      - route: note
views:
  - type: table
    name: every ticket
    order:
      - name
      - flags
      - queue
    nest: group
    sort:
      - key: queue
    collapsed:
      - closed
