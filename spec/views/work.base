filters:
  - kind: ticket
properties:
  name:
    opensNote: true
columnSize:
  name: 34
  state: 8
  standing: 9
  flags: 5
  step: 10
  group: 20
flags:
  - letter: U
    key: urgent
  - letter: W
    key: held
  - letter: T
    key: todo
groups:
  - name: not done
    pressed: true
    filters:
      - not state: closed
  - name: held
    filters:
      - standing: held
  - name: unsorted
    filters:
      - "state: draft or not group: /./"
    sort:
      - key: name
views:
  - type: table
    name: every ticket
    order:
      - name
      - state
      - standing
      - flags
      - step
      - group
      - says
    nest: group
    sort:
      - key: urgent
        down: true
      - key: name
    collapsed:
      - closed
