{
  "comment": "WHAT IS PROJECTED WHERE. Each entry is one projection, and the engine writes every one at each session start. Adding a projection is an entry here and no code change. A target is read-only to a person: the write door refuses a write to one, and ./RUNME.sh check refuses one standing stale.",
  "projections": [
    {
      "name": "the config commands",
      "shape": "config commands",
      "target": ".claude/commands",
      "writes": ["se-config-*.md", "se-agent-control-*.md"],
      "from": "spec/config/level0.json",
      "schema": "spec/config/level0.schema.json",
      "wrap": "frontmatter"
    },
    {
      "name": "the retro command",
      "shape": "retro command",
      "target": ".claude/commands",
      "writes": ["se-retro.md"],
      "from": "spec/processes/retro.yaml",
      "wrap": "frontmatter"
    },
    {
      "name": "the paragraph rules",
      "shape": "paragraph rules",
      "target": "spec/config/styles/VoiceParagraph",
      "from": "spec/schemas/paragraph.schema.yaml",
      "schema": "spec/schemas/paragraph.schema.schema.json",
      "wrap": "none"
    },
    {
      "name": "the output style",
      "shape": "output style",
      "target": ".claude/output-styles",
      "from": "spec/guidance",
      "wrap": "frontmatter"
    }
  ]
}
