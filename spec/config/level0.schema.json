{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level zero",
  "type": "object",
  "required": [
    "stop",
    "answer",
    "log",
    "judge",
    "names",
    "ask"
  ],
  "properties": {
    "comment": {
      "type": "string"
    },
    "answer": {
      "type": "object",
      "required": [
        "enabled",
        "warnAt",
        "ceiling"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "help": "The door holding the owner's prompt first. false takes it out."
        },
        "warnAt": {
          "type": "number",
          "unit": "findings a thousand words",
          "help": "The score where the findings start riding the next prompt."
        },
        "ceiling": {
          "type": "number",
          "unit": "findings a thousand words",
          "help": "The score where the gate asks for one rewrite."
        }
      }
    },
    "stop": {
      "type": "object",
      "required": [
        "enabled",
        "mostInARow",
        "hold"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "help": "The tooth. false ends every turn where the agent asks to end it."
        },
        "mostInARow": {
          "type": "number",
          "unit": "turns",
          "help": "The turns the tooth carries one after another before it lets go."
        },
        "hold": {
          "type": "string",
          "enum": [
            "running",
            "finishing",
            "stopped"
          ],
          "help": "What the session does when it reaches the end of a turn.",
          "widget": "toggle",
          "gesture": 5,
          "icon": "✋🤖",
          "group": "agent control",
          "row": 0,
          "column": 1,
          "rowSpan": 1,
          "colSpan": 1
        }
      }
    },
    "ask": {
      "type": "object",
      "required": [
        "wanted"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "wanted": {
          "type": "string",
          "enum": [
            "quiet",
            "short",
            "full"
          ],
          "help": "What the owner wants said at the end of this turn.",
          "widget": "toggle",
          "gesture": 5,
          "icon": "❓🤖",
          "group": "agent control",
          "row": 0,
          "column": 2,
          "rowSpan": 1,
          "colSpan": 1
        }
      }
    },
    "log": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "help": "The level this box writes at. info writes every line a door says."
        },
        "open": {
          "help": "Open the log viewer, in a terminal beside the editor.",
          "widget": "action",
          "icon": "📜",
          "group": "agent control",
          "row": 0,
          "column": 0,
          "rowSpan": 1,
          "colSpan": 1,
          "keys": [
            "w s move up and down the log",
            "enter open the details, and enter again closes them",
            "up down scroll the details",
            "pgup pgdown step a whole window",
            "home the first line, end the newest, and it follows",
            "q leave"
          ],
          "runs": "./RUNME.sh log"
        }
      }
    },
    "judge": {
      "type": "object",
      "required": [
        "enabled",
        "model",
        "maxSpans",
        "warmupWrites",
        "thenEveryNth"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "help": "The model reading a write. false leaves the mechanical rules alone."
        },
        "model": {
          "type": "string",
          "help": "The model the judge asks."
        },
        "maxSpans": {
          "type": "number",
          "unit": "spans",
          "help": "The spans one reading carries at most."
        },
        "warmupWrites": {
          "type": "number",
          "unit": "writes",
          "help": "The writes a session judges before it starts skipping."
        },
        "thenEveryNth": {
          "type": "number",
          "unit": "writes",
          "help": "After the warmup, the judge reads one write in this many."
        }
      }
    },
    "names": {
      "type": "object",
      "required": [
        "words"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "words": {
          "type": "number",
          "unit": "words",
          "help": "The words a file, a folder and a branch name each hold at most."
        }
      }
    },
    "work": {
      "comment": "Level one. The knobs the work verbs read over a group and its tickets.",
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "staleAfter": {
          "type": "string",
          "unit": "a span, as 90m, 12h or 3d",
          "help": "The age of a held group's tip that puts it under yours."
        }
      }
    },
    "engine": {
      "comment": "Level one. Each key here names a widget nothing draws yet, because an engine has to answer it first. Marking a group is what draws one.",
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "rest",
            "running"
          ],
          "help": "What a person last asked the engine to do.",
          "widget": "status",
          "sets": "engine.state",
          "watches": "engine.beat",
          "icon": "the owner picks one mark per state: play and stop",
          "gesture": 1
        },
        "beat": {
          "type": "number",
          "unit": "seconds",
          "help": "The beat the engine touches, which the light beside it reads."
        },
        "binding": {
          "type": "string",
          "enum": [
            "queue",
            "unbound",
            "god"
          ],
          "help": "Where the session takes its work from.",
          "widget": "toggle",
          "gesture": 5,
          "icon": "❌🔗🤖",
          "group": "agent control",
          "row": 0,
          "column": 3,
          "rowSpan": 1,
          "colSpan": 1
        },
        "autonomy": {
          "type": "string",
          "enum": [
            "finish",
            "start",
            "ideation"
          ],
          "help": "How far the session goes on its own.",
          "widget": "toggle",
          "gesture": 5,
          "icon": "U+1F680"
        }
      }
    }
  }
}
